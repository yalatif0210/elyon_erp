# ===========================================================================
#  VARIABLES D'ENVIRONNEMENT — MODÈLE
#
#  Copier vers .env et remplacer TOUTES les valeurs. Le fichier .env est
#  exclu du dépôt (.gitignore) et ne doit jamais y être committé.
#
#  Génération de secrets robustes :
#      openssl rand -base64 48        (secrets JWT)
#      openssl rand -hex 32           (clé de chiffrement TOTP, 32 octets)
# ===========================================================================

# --- PostgreSQL -----------------------------------------------------------
# Rôle propriétaire : DDL, utilisé UNIQUEMENT par les migrations.
POSTGRES_USER=erp_migrator
POSTGRES_PASSWORD=REMPLACER_mot_de_passe_migrator
POSTGRES_DB=erp

# Rôle applicatif : DML seul, aucun DDL, aucun effacement d'audit.
ERP_APP_PASSWORD=REMPLACER_mot_de_passe_application

# --- Redis ----------------------------------------------------------------
REDIS_PASSWORD=REMPLACER_mot_de_passe_redis

# --- API ------------------------------------------------------------------
NODE_ENV=production
API_PORT=3000
WEB_PORT=4200
PORTAL_PORT=4300

# Secrets cryptographiques. Distincts l'un de l'autre, jamais réutilisés.
JWT_ACCESS_SECRET=REMPLACER_openssl_rand_base64_48
JWT_REFRESH_SECRET=REMPLACER_openssl_rand_base64_48_DIFFERENT
# Clé AES-256-GCM (64 caractères hexadécimaux) protégeant les secrets TOTP au repos.
TOTP_ENCRYPTION_KEY=REMPLACER_openssl_rand_hex_32

# Origines autorisées, séparées par des virgules. Aucun joker en production.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300

# --- Métier ---------------------------------------------------------------
# Devise pivot : dénominateur commun du risque crédit et de la marge
# consolidée. Une seule dans tout le système (SPECIFICATIONS.md § 9.2).
PIVOT_CURRENCY=USD
# Devise légale du pays d'exploitation. Le franc CFA n'a pas de subdivision
# en circulation : tout montant imprimé en XOF est un entier.
LOCAL_CURRENCY=XOF
# Pays dont le régime fiscal s'applique aux pièces émises (§ 9.4).
FISCAL_COUNTRY=CI

# --- Jeu de données de démonstration --------------------------------------
# Mot de passe initial des comptes créés par le seed. Tous les comptes sont
# créés avec must_change_password = true.
SEED_DEFAULT_PASSWORD=ChangeMe!2026

# --- Développement uniquement (docker-compose.dev.yml) --------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
