# Les paquets Angular se contredisent sur chokidar : @angular/compiler-cli
# exige ^4, que @angular-devkit/core declare en dependance de pair a ^3.5.2.
# npm install tolere l'ecart, npm ci le revalide strictement et echoue.
# Ce drapeau aligne les deux commandes. Versionne : tous les environnements,
# poste local comme VPS, resolvent a l'identique.
legacy-peer-deps=true
