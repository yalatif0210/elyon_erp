// ============================================================================
//  ERP ELYON TRADING — SCHÉMA DE DONNÉES
//  LOT 1 : SOCLE & RÉFÉRENTIELS          (SPECIFICATIONS.md § 18)
//
//  Pays : Côte d'Ivoire · Devise pivot : USD · Devise locale : XOF
//
//  PÉRIMÈTRE DE CE LOT
//  -------------------
//  Authentification (3 réalms) · référentiel monétaire · tiers, sites et
//  conformité · produits · références de prix · répertoire des postes de coûts
//  et grilles de seuils · transport et conformité des moyens · GED · registre
//  des dérogations · audit.
//
//  ARRIVE AU LOT 2 : Contrat → Deal → Opération, HSE d'exécution, relevés de
//  mesure, facturation, documents signés, journal terrain.
//
//  ⚠️ Les modèles transactionnels de la v2 (Deal, PurchaseOrder, CqqReport,
//  Invoice…) sont retirés : ils encodaient la contrainte back-to-back 1-to-1
//  qui n'est plus vraie (§ 4.4). Ils sont reconstruits au lot 2 sur la
//  hiérarchie à trois niveaux.
//
//  CONVENTIONS
//  -----------
//  1. AUCUN Float sur une donnée monétaire ou volumétrique.
//     Montants (18,4) · Volumes (18,6) · Taux FX (18,8) · Ratios (9,6)
//  2. Aucune constante métier en dur : devises, seuils, tolérances, postes de
//     coûts, checklists sont des TABLES, pas des énumérations figées.
//  3. Les contraintes que Prisma ne sait pas exprimer vivent dans prisma/sql/,
//     injectées DANS les migrations par scripts/prepare-migrations.mjs.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
//  ÉNUMÉRATIONS
//  Ne sont énumérés que les concepts fermés par nature — un rôle, un état.
//  Tout ce que l'exploitation doit pouvoir étendre est une table.
// ============================================================================

/// Rôles internes. Réf. § 3.1
enum UserRole {
  DG
  ASSISTANT_DG
  IT_ADMIN
  CCOO
  SALES_REP
  LOGISTICS_COORD
  FINANCE_CFO
  ACCOUNTANT

  @@map("user_role")
}

/// Rôles terrain — réalm distinct des rôles internes (§ 1.4).
enum FieldRole {
  FIELD_AGENT
  HSE_CONTROLLER

  @@map("field_role")
}

enum ActorType {
  INTERNAL_USER
  PORTAL_USER
  FIELD_USER
  SYSTEM

  @@map("actor_type")
}

enum PartnerType {
  CLIENT
  PROSPECT
  SUPPLIER
  CARRIER
  INSPECTOR

  @@map("partner_type")
}

/// Segment commercial. Détermine le DÉFAUT de formule de prix, jamais la règle :
/// la formule appliquée est surchargeable au niveau du Deal (§ 5.1).
enum CommercialSegment {
  MARITIME
  B2B
  RETAIL

  @@map("commercial_segment")
}

enum CreditStatus {
  ACTIVE
  WATCH
  BLOCKED

  @@map("credit_status")
}

enum UnitOfMeasure {
  L // Litre
  M3 // Mètre cube
  MT // Tonne métrique
  BBL // Baril
  /// Prestation forfaitaire — un produit SERVICE (ex. barge), sans mesure
  /// volumétrique. Le prix unitaire porte alors le montant total : le volume
  /// contracté vaut 1 par convention, pour que la chaîne de marge (exprimée
  /// « par unité » partout ailleurs) reste valable sans cas particulier.
  FORFAIT

  @@map("unit_of_measure")
}

enum TransportMode {
  PIPELINE
  BUNKERING // Soutage maritime
  BARGE
  TRUCK
  RAIL

  @@map("transport_mode")
}

/// Régime documentaire et fiscal — champ obligatoire du § 9.4.
enum DocumentaryRegime {
  PROFORMA_ONLY
  PROFORMA_THEN_SIMPLE
  PROFORMA_THEN_FNE
  SIMPLE_DIRECT
  FNE_DIRECT
  OTHER

  @@map("documentary_regime")
}

/// Nature d'un poste de coût — axe d'IMPUTATION.
enum CostNature {
  DIRECT // Imputable à une opération
  INDIRECT // Absorbé via un taux (§ 14.2)

  @@map("cost_nature")
}

/// Variabilité d'un poste de coût — axe de COMPORTEMENT, indépendant du précédent.
/// Indispensable au point mort (§ 14.5). Voir la note du modèle CostPost.
enum CostVariability {
  VARIABLE
  FIXED

  @@map("cost_variability")
}

/// Assiette de répartition des charges indirectes.
enum AllocationBasis {
  PER_VOLUME // Au litre / m³ / tonne
  PER_OPERATION // Au nombre d'opérations
  PER_REVENUE // Au prorata du chiffre d'affaires

  @@map("allocation_basis")
}

/// Origine d'un taux de change (§ 9.2).
enum FxRateType {
  PEG // Parité fixe réglementaire — non révisable (XOF/EUR = 655,957)
  OFFICIAL // Cours officiel BCEAO
  BANK // Cours bancaire effectif
  CONTRACTUAL // Taux stipulé au contrat
  INTERNAL // Taux interne de gestion
  BUDGET // Taux budgétaire

  @@map("fx_rate_type")
}

/// Nature d'une référence de prix (§ 5.5).
enum PriceReferenceType {
  SIR // Prix SIR
  PUMP // Prix à la pompe DGH
  SUPPLIER // Prix fournisseur négocié
  CONTRACTUAL // Prix contractuel

  @@map("price_reference_type")
}

enum VehicleType {
  TANKER_TRUCK
  RAIL_WAGON
  BUNKER_BARGE
  PIPELINE_SECTION
  OTHER

  @@map("vehicle_type")
}

/// Nature d'une pièce de conformité (§ 6.4).
enum ComplianceType {
  CUSTOMS_LICENSE
  MINISTERIAL_APPROVAL
  IMPORT_EXPORT_LICENSE
  INSURANCE
  TECHNICAL_INSPECTION
  DRIVER_LICENSE
  DRIVER_TRAINING
  HSE_CERTIFICATION
  VESSEL_CERTIFICATE
  SAFETY_DATA_SHEET
  OTHER

  @@map("compliance_type")
}

enum ComplianceStatus {
  VALID
  EXPIRING // Dans la fenêtre de préavis
  EXPIRED
  SUSPENDED

  @@map("compliance_status")
}

/// Registre unique des dérogations (§ 11.4).
enum CostBasis {
  PER_UNIT // Au litre, au m³, à la tonne — proportionnel au volume
  FIXED // Forfait pour l'affaire — indépendant du volume

  @@map("cost_basis")
}

enum DerogationType {
  MARGIN_BELOW_THRESHOLD // Marge complète sous le seuil → accord DG
  MARGIN_BELOW_DIRECT_FLOOR // Plancher direct franchi → DG seul, exceptionnel
  HSE_BLOCKING_OVERRIDE // Levée d'un contrôle HSE bloquant
  TRANSPORT_NON_COMPLIANCE // Affectation d'un moyen non conforme → DG seul
  HSE_DELEGATION // Suppléance du contrôleur HSE (§ 3.4)
  ULLAGE_ACKNOWLEDGEMENT // Acquittement d'un écart de volume
  PURCHASE_PRICE_VARIANCE // Prix d'achat hors de la bande de tolérance (§ 5.4)
  CREDIT_LIMIT_OVERRIDE // Approbation au-delà du plafond de crédit client (§ 9.1)
  OTHER

  @@map("derogation_type")
}

enum DerogationStatus {
  ACTIVE
  EXPIRED
  REVOKED
  CLOSED

  @@map("derogation_status")
}

/// Caractère d'un point de contrôle HSE (§ 7.1).
enum HseControlLevel {
  RECOMMENDED
  MANDATORY
  CONDITIONAL
  BLOCKING // Empêche la poursuite de l'opération

  @@map("hse_control_level")
}

/// À quoi sert un site — un lieu peut servir aux DEUX.
///
/// Décision de la direction, 7 août 2026 :
///
///   « Nous avons les sites de déchargement (livraison), pas encore ceux de
///     chargement (approvisionnement). Cela implique la possibilité qu'un site
///     de chargement soit également un site de déchargement. »
///
/// ⚠️ C'est un TABLEAU, et c'est tout l'objet. Un dépôt côtier reçoit du
///    produit par barge et en charge des camions le même jour ; le modéliser
///    par un champ unique obligerait à le créer deux fois — et avec lui ses
///    consignes d'accès, ses horaires, son badge. L'une des copies se
///    périmerait.
enum SiteUsage {
  /// Chargement — approvisionnement. Dépôt, terminal, raffinerie.
  LOADING
  /// Déchargement — livraison. Site client, station, mine.
  DELIVERY

  @@map("site_usage")
}

/// Nature d'une pièce jointe produite sur le terrain (§ 10.2).
///
/// Elle n'est pas décorative : c'est elle qui distingue une exigence de photo
/// d'une exigence de signature. Les confondre reviendrait à tenir un bon de
/// livraison pour signé parce qu'on a photographié le camion.
enum AttachmentKind {
  PHOTO
  /// Signature capturée à l'écran — client, chauffeur, contrôleur.
  SIGNATURE
  /// Pièce numérisée : autorisation d'accès, permis de travail, bon papier.
  DOCUMENT

  @@map("attachment_kind")
}

/// Régime photographique d'un point de contrôle (§ 7.1 bis).
///
/// Trois états, et non un booléen : « facultative » et « interdite » ne sont
/// pas la même chose, et les confondre revient à laisser l'application décider
/// à la place du paramétrage.
enum HsePhotoPolicy {
  /// Aucun appareil photo proposé. La prise de vue est proscrite en zone
  /// ATEX, sur certains dépôts, et chez des clients qui l'interdisent
  /// contractuellement : y afficher un bouton met l'agent en faute.
  FORBIDDEN
  /// Proposée, jamais exigée — un constat imprévu se photographie là où il se
  /// trouve, sans que le paramétrage ait eu à le prévoir.
  OPTIONAL
  /// Exigée : le point ne peut pas être enregistré tant qu'aucune pièce ne
  /// lui est rattachée. Le verrou est tenu EN BASE, pas dans l'application.
  REQUIRED

  @@map("hse_photo_policy")
}

/// Niveau de risque d'une opération — détermine la checklist applicable
/// et l'exigence de présence du contrôleur HSE (§ 7.2).
enum HseRiskLevel {
  STANDARD // Auto-contrôle par l'agent
  REINFORCED // Contrôleur requis, validation à distance possible
  CRITICAL // Présence physique obligatoire

  @@map("hse_risk_level")
}

/// Phase de l'opération à laquelle un contrôle s'applique.
enum OperationPhase {
  PREPARATION
  PRE_DEPARTURE
  LOADING
  TRANSPORT
  DELIVERY
  CLOSING

  @@map("operation_phase")
}

enum DocumentType {
  MINISTERIAL_APPROVAL
  IMPORT_EXPORT_LICENSE
  SAFETY_DATA_SHEET
  CUSTOMS_CERTIFICATE
  INSURANCE_POLICY
  TECHNICAL_INSPECTION
  DRIVER_DOCUMENT
  VESSEL_CERTIFICATE
  CONTRACT
  MEASUREMENT_REPORT
  DELIVERY_NOTE
  OPERATION_REPORT
  INVOICE_PDF
  PROFORMA_PDF
  TRANSPORT_ORDER
  OTHER

  @@map("document_type")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  APPROVE
  REJECT
  OVERRIDE
  DEROGATION_GRANTED
  LOGIN
  LOGIN_FAILED
  LOGOUT
  EXPORT
  PASSWORD_RESET

  @@map("audit_action")
}

// ============================================================================
//  RÉFÉRENTIEL MONÉTAIRE
//  Réf. § 9.2 — cinq plans monétaires, aucune devise codée en dur.
// ============================================================================

/// Référentiel des devises. Table de données, jamais de constantes :
/// une bascule monétaire en Côte d'Ivoire doit être une ligne insérée,
/// pas une migration de schéma.
model Currency {
  /// Code ISO 4217 (USD, XOF, EUR…).
  code   String @id @db.Char(3)
  name   String @db.VarChar(80)
  symbol String @db.VarChar(8)

  /// Décimales de restitution. XOF = 0 : le franc CFA n'a pas de subdivision
  /// en circulation. TOUT montant imprimé dans cette devise y est arrondi.
  decimalPlaces Int @default(2) @map("decimal_places") @db.SmallInt

  /// Devise pivot — plan « reporting » du § 9.2. Une seule dans le système,
  /// garantie par index unique partiel.
  isPivot Boolean @default(false) @map("is_pivot")
  /// Devise de tenue de comptes — plan « fonctionnelle ».
  isFunctional Boolean @default(false) @map("is_functional")
  /// Devise légale du pays d'exploitation.
  isLocal Boolean @default(false) @map("is_local")
  /// Proposée à l'éditeur au moment d'imprimer une pièce.
  isDocumentEligible Boolean @default(true) @map("is_document_eligible")

  /// Parité fixe éventuelle (XOF arrimé à l'EUR à 655,957). Renseignée, elle
  /// interdit toute saisie manuelle d'un taux divergent — trigger en base.
  pegCurrencyCode  String?    @map("peg_currency_code") @db.Char(3)
  pegCurrency      Currency?  @relation("CurrencyPeg", fields: [pegCurrencyCode], references: [code], onDelete: Restrict)
  peggedCurrencies Currency[] @relation("CurrencyPeg")
  /// Unités de cette devise pour 1 unité de la devise d'arrimage.
  pegRate Decimal? @map("peg_rate") @db.Decimal(18, 8)

  /// Date de mise en circulation — support d'une bascule monétaire (§ 9.2).
  activeFrom DateTime? @map("active_from") @db.Date
  activeTo   DateTime? @map("active_to") @db.Date

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  fxRatesAsBase  FxRate[] @relation("FxBase")
  fxRatesAsQuote FxRate[] @relation("FxQuote")

  partnersBilling     Partner[]          @relation("PartnerBillingCurrency")
  partnersCreditLimit Partner[]          @relation("PartnerCreditLimitCurrency")
  administeredPrices  AdministeredPrice[]
  supplierPrices      SupplierPrice[]
  marginThresholds    MarginThreshold[]
  costPools           CostPool[]


  // --- Relations inverses du lot 2 ---
  contracts Contract[] @relation("ContractCurrency")
  deals Deal[] @relation("DealCurrency")
  assignments OperationAssignment[] @relation("AssignmentCurrency")
  purchaseOrders PurchaseOrder[] @relation("PoCurrency")
  operationCostLines OperationCostLine[] @relation("CostLineCurrency")
  dealCostLines      DealCostLine[]     @relation("DealCostLineCurrency")
  costStandards       CostStandard[]     @relation("CostStandardCurrency")
  invoicesTransaction Invoice[] @relation("InvoiceCurrency")
  invoicesDocument Invoice[] @relation("InvoiceDocumentCurrency")
  payments Payment[] @relation("PaymentCurrency")
  supplierInvoices SupplierInvoice[] @relation("SupplierInvoiceCurrency")
  guarantees Guarantee[] @relation("GuaranteeCurrency")

  @@map("currencies")
  carrierTariffs CarrierTariff[] @relation("CarrierTariffCurrency")

  salesForecastsRef SalesForecast[]

  crmOpportunities CrmOpportunity[] @relation("CrmOpportunityCurrency")

  vehicleMaintenanceEvents VehicleMaintenanceEvent[]
}

/// Historique des taux de change. Un taux n'est JAMAIS écrasé : on insère une
/// nouvelle ligne datée. Toute pièce émise conservera le lien vers le taux
/// exact qui l'a chiffrée — elle reste reproductible à l'identique des années
/// plus tard, quels que soient les cours ultérieurs.
model FxRate {
  id String @id @default(uuid()) @db.Uuid

  baseCurrencyCode  String   @map("base_currency_code") @db.Char(3)
  baseCurrency      Currency @relation("FxBase", fields: [baseCurrencyCode], references: [code], onDelete: Restrict)
  quoteCurrencyCode String   @map("quote_currency_code") @db.Char(3)
  quoteCurrency     Currency @relation("FxQuote", fields: [quoteCurrencyCode], references: [code], onDelete: Restrict)

  /// Unités de quoteCurrency pour 1 unité de baseCurrency.
  /// Ex. base=USD, quote=XOF, rate=605,42 → 1 USD = 605,42 FCFA.
  rate Decimal @db.Decimal(18, 8)

  rateType FxRateType @default(OFFICIAL) @map("rate_type")

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  notes String? @db.VarChar(500)

  enteredById String? @map("entered_by_id") @db.Uuid
  enteredBy   User?   @relation(fields: [enteredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)


  // --- Relations inverses du lot 2 ---
  deals Deal[] @relation("DealFxRate")
  invoicesDocumentRate Invoice[] @relation("InvoiceDocumentFxRate")

  @@unique([baseCurrencyCode, quoteCurrencyCode, rateType, effectiveFrom])
  @@index([baseCurrencyCode, quoteCurrencyCode, effectiveFrom(sort: Desc)])
  @@map("fx_rates")
}

// ============================================================================
//  AUTHENTIFICATION — TROIS RÉALMS DISTINCTS
//  Réf. § 1.4 — trois tables séparées : aucune élévation de privilège par
//  confusion de rôle n'est structurellement possible.
// ============================================================================

/// Compte interne.
model User {
  id       String   @id @default(uuid()) @db.Uuid
  email    String   @unique @db.VarChar(255)
  fullName String   @map("full_name") @db.VarChar(160)
  role     UserRole
  isActive Boolean  @default(true) @map("is_active")

  passwordHash       String    @map("password_hash") @db.VarChar(255) // Argon2id
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(3)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  /// Secret TOTP chiffré au repos. Obligatoire pour DG, CFO, ACCOUNTANT,
  /// IT_ADMIN — imposé à la connexion (lot 1, couche API).
  totpSecretEnc       String?   @map("totp_secret_enc") @db.VarChar(512)
  totpEnabled         Boolean   @default(false) @map("totp_enabled")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts") @db.SmallInt
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions             UserSession[]
  fxRatesEntered       FxRate[]
  supplierPricesValid  SupplierPrice[]      @relation("SupplierPriceValidator")
  administeredPrices   AdministeredPrice[]  @relation("AdministeredPriceRecorder")
  documentsUploaded    Document[]
  complianceRecords    ComplianceRecord[]   @relation("ComplianceRecorder")
  companyAccreditationsRecorded CompanyAccreditation[] @relation("CompanyAccreditationRecorder")
  derogationsRequested Derogation[]         @relation("DerogationRequester")
  derogationsGranted   Derogation[]         @relation("DerogationAuthority")
  delegationsGranted   Delegation[]         @relation("DelegationGrantor")
  delegationsReceived  Delegation[]         @relation("DelegationDelegate")
  absorptionRates      AbsorptionRate[]     @relation("AbsorptionRateAuthor")
  marginThresholds     MarginThreshold[]    @relation("MarginThresholdAuthor")
  ullageTolerances     UllageTolerance[]    @relation("UllageToleranceAuthor")
  costStandards        CostStandard[]       @relation("CostStandardAuthor")


  // --- Relations inverses du lot 2 ---
  contractsOwned Contract[] @relation("ContractOwner")
  dealsOwned Deal[] @relation("DealOwner")
  dealsCreditApproved Deal[] @relation("DealCreditApprover")
  dealsDgApproved Deal[] @relation("DealDgApprover")
  dealTransitions DealStatusTransition[]
  operationsCoordinated Operation[] @relation("OperationCoordinator")
  operationsHseValidated Operation[] @relation("OperationHseValidatorUser")
  assignmentsAuthored OperationAssignment[] @relation("AssignmentAuthor")
  purchaseOrdersIssued PurchaseOrder[] @relation("PoIssuer")
  hseChecksValidated OperationHseCheck[] @relation("HseCheckValidatorUser")
  hseChecksRejected OperationHseCheck[] @relation("HseCheckRejectorUser")
  operationalProceduresUpdated OperationalProcedure[]
  hseEventsDeclared HseEvent[] @relation("HseEventDeclarerUser")
  hseEventsClosed HseEvent[] @relation("HseEventCloser")
  correctiveActions HseCorrectiveAction[] @relation("ActionOwner")
  ullageAcknowledged MeasurementRecord[] @relation("UllageAcknowledger")
  measurementsEntered MeasurementRecord[] @relation("MeasurementRecorderUser")
  invoicesCreated Invoice[] @relation("InvoiceCreator")
  invoicesIssued Invoice[] @relation("InvoiceIssuer")
  invoicesCancelled Invoice[] @relation("InvoiceCanceller")
  simpleInvoiceDecisions Invoice[] @relation("SimpleInvoiceDecider")
  paymentsRecorded Payment[] @relation("PaymentRecorder")
  supplierInvoicesRecorded SupplierInvoice[] @relation("SupplierInvoiceRecorder")
  guaranteesRecorded2 Guarantee[] @relation("GuaranteeRecorder")
  documentsGenerated GeneratedDocument[] @relation("DocumentGenerator")
  signatures Signature[] @relation("SignatureUser")
  vehicleMaintenanceEventsRecorded VehicleMaintenanceEvent[]
  dunningActionsRecorded DunningAction[]

  @@index([role, isActive])
  @@map("users")
  siteRequirementAcks OperationSiteRequirementAck[] @relation("SiteRequirementAck")

  fiscalYearsAuthored      FiscalYear[]      @relation("FiscalYearAuthor")
  financingRatesAuthored   FinancingRate[]   @relation("FinancingRateAuthor")
  salesForecastsAuthored   SalesForecast[]   @relation("SalesForecastAuthor")

  crmOpportunitiesOwned CrmOpportunity[] @relation("CrmOpportunityOwner")
  crmInteractions       CrmInteraction[] @relation("CrmInteractionAuthor")
}

/// Session interne. Le token n'est jamais stocké : seul son hash SHA-256.
model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  ipAddress String?   @map("ip_address") @db.Inet
  userAgent String?   @map("user_agent") @db.VarChar(512)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// Compte client extranet. Toujours rattaché à un Partner, ce qui porte
/// le cloisonnement par ligne (§ 1.3).
model PortalUser {
  id        String  @id @default(uuid()) @db.Uuid
  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  email    String  @unique @db.VarChar(255)
  fullName String  @map("full_name") @db.VarChar(160)
  isActive Boolean @default(true) @map("is_active")

  passwordHash        String    @map("password_hash") @db.VarChar(255)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(3)
  mustChangePassword  Boolean   @default(true) @map("must_change_password")
  totpSecretEnc       String?   @map("totp_secret_enc") @db.VarChar(512)
  totpEnabled         Boolean   @default(false) @map("totp_enabled")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts") @db.SmallInt
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)


  // --- Relations inverses du lot 2 ---
  dealAcceptances Deal[] @relation("DealAcceptedBy")
  invoiceAcceptances Invoice[] @relation("InvoiceAcceptedBy")
  quotationRequests QuotationRequest[]

  @@index([partnerId, isActive])
  @@map("portal_users")
}

enum QuotationRequestStatus {
  NEW
  IN_REVIEW
  /// Le client a approuvé l'une des proforma soumises, depuis son portail.
  /// Rien n'est encore une affaire : c'est ce statut qui rend la conversion
  /// manuelle possible, pas la demande elle-même (§ discussion 17/08).
  PROFORMA_APPROVED
  CONVERTED
  DECLINED

  @@map("quotation_request_status")
}

/// Demande de cotation déposée depuis le portail client (§ 13, module 0).
///
/// Volontairement LÉGER : un client ne chiffre rien, ne négocie rien, ne
/// voit ni prix ni marge. Il exprime un besoin ; c'est un commercial qui le
/// transforme en `Deal` — avec le prix, les conditions et les contrôles que
/// cela suppose. Rien dans SPECIFICATIONS.md ne décrit ce modèle en détail
/// (§13 ne donne que l'intitulé fonctionnel) : le périmètre ci-dessus est
/// le plus étroit qui couvre « demande de quotation » sans l'outrepasser.
model QuotationRequest {
  id String @id @default(uuid()) @db.Uuid

  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  submittedByPortalUserId String     @map("submitted_by_portal_user_id") @db.Uuid
  submittedByPortalUser   PortalUser @relation(fields: [submittedByPortalUserId], references: [id], onDelete: Restrict)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  desiredVolume       Decimal       @map("desired_volume") @db.Decimal(18, 6)
  uom                 UnitOfMeasure
  desiredDeliveryDate DateTime?     @map("desired_delivery_date") @db.Date
  message             String?       @db.VarChar(2000)

  status QuotationRequestStatus @default(NEW)

  /// Toutes les proforma soumises en réponse — une demande peut en porter
  /// plusieurs, selon la teneur des négociations (§ discussion 17/08).
  proformas Invoice[] @relation("QuotationProformas")

  /// La proforma que le CLIENT a approuvée depuis son portail. C'est ELLE,
  /// et non le statut seul, qui dit laquelle a gagné quand plusieurs
  /// coexistent — indispensable pour annuler les autres à la conversion.
  approvedProformaId String?  @unique @map("approved_proforma_id") @db.Uuid
  approvedProforma    Invoice? @relation("QuotationApprovedProforma", fields: [approvedProformaId], references: [id], onDelete: SetNull)

  /// Renseigné quand un commercial en fait une affaire — la demande reste,
  /// elle ne se transforme pas en silence.
  convertedDealId String? @unique @map("converted_deal_id") @db.Uuid
  convertedDeal   Deal?   @relation(fields: [convertedDealId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([partnerId, status])
  @@index([status, createdAt])
  @@map("quotation_requests")
}

/// Compte terrain — agent d'opération ou contrôleur HSE.
/// Réalm distinct : ces comptes n'accèdent à AUCUNE donnée commerciale
/// (prix, marge, encours, facture), par construction des DTO (§ 10.3).
model FieldUser {
  id       String    @id @default(uuid()) @db.Uuid
  email    String    @unique @db.VarChar(255)
  fullName String    @map("full_name") @db.VarChar(160)
  role     FieldRole
  isActive Boolean   @default(true) @map("is_active")

  passwordHash       String    @map("password_hash") @db.VarChar(255)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(3)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  totpSecretEnc      String?   @map("totp_secret_enc") @db.VarChar(512)
  totpEnabled        Boolean   @default(false) @map("totp_enabled")
  failedLoginAttempts Int      @default(0) @map("failed_login_attempts") @db.SmallInt
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)

  /// Identifiant de l'appareil durci affecté — support de l'effacement
  /// à distance et de la détection d'usage anormal (§ 10.5).
  assignedDeviceId String? @map("assigned_device_id") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  delegationsReceived Delegation[] @relation("DelegationFieldDelegate")


  // --- Relations inverses du lot 2 ---
  operationsAssigned Operation[] @relation("OperationFieldAgent")
  operationsHseValidated Operation[] @relation("OperationHseValidator")
  hseChecksValidated OperationHseCheck[] @relation("HseCheckValidator")
  hseChecksRejected OperationHseCheck[] @relation("HseCheckRejector")
  hseItemsRecorded OperationHseCheckItem[] @relation("HseItemRecorder")
  hseEventsDeclared HseEvent[] @relation("HseEventDeclarer")
  measurementsEntered MeasurementRecord[] @relation("MeasurementRecorder")
  signatures Signature[] @relation("SignatureFieldUser")
  syncEvents FieldSyncEvent[] @relation("FieldEventAuthor")

  @@index([role, isActive])
  @@map("field_users")
}

/// Nature d'un événement produit sur la tablette (§ 10.2).
///
/// La liste est FERMÉE, et c'est voulu : chaque nature correspond à une
/// opération de domaine dont les invariants sont déjà tenus côté serveur. Un
/// événement générique « mise à jour » rouvrirait la porte à la synchronisation
/// d'états — celle qui fabrique des conflits insolubles.
enum FieldEventType {
  /// Ouverture d'une checklist sur une phase.
  CHECK_OPENED
  /// Renseignement d'un point par l'agent. RENSEIGNER N'EST PAS VALIDER.
  CHECK_ITEM_RECORDED
  /// Validation d'une checklist par le contrôleur HSE.
  CHECK_VALIDATED
  /// Rejet d'une checklist par le contrôleur HSE — ne passe pas en l'état.
  CHECK_REJECTED
  /// Relevé de volume et de température.
  MEASUREMENT_RECORDED
  /// Avancement de l'opération à l'étape suivante.
  STATUS_ADVANCED
  /// Déclaration d'incident, quasi-accident ou observation dangereuse.
  HSE_EVENT_DECLARED

  @@map("field_event_type")
}

/// Sort d'un événement à l'arrivée.
enum FieldEventStatus {
  /// Appliqué : l'état du serveur en tient compte.
  ACCEPTED
  /// Refusé par un invariant. Le motif redescend sur l'appareil (§ 10.2).
  REJECTED
  /// Non traité parce qu'un événement ANTÉRIEUR de la même opération a été
  /// refusé. Ni appliqué ni perdu : il repartira au prochain envoi, une fois
  /// le blocage levé sur l'appareil.
  DEFERRED

  @@map("field_event_status")
}

/// Journal d'événements terrain — EN AJOUT SEUL (§ 10.2).
///
/// « La tablette ne détient pas une copie modifiable de l'opération qu'elle
/// renverrait au serveur — cette approche fabrique des conflits insolubles. »
///
/// ⚠️ L'identifiant est celui GÉNÉRÉ SUR L'APPAREIL, et il est la clé primaire,
///    non une colonne annexe. C'est lui, et non un code de déduplication, qui
///    rend la synchronisation idempotente : un renvoi après coupure retombe sur
///    la même ligne et la clé refuse le doublon, sans qu'aucun code applicatif
///    n'ait à s'en préoccuper. Un identifiant serveur avec `clientUuid` unique
///    à côté aurait laissé un chemin d'écriture sans déduplication.
model FieldSyncEvent {
  id String @id @db.Uuid

  operationId String    @map("operation_id") @db.Uuid
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  fieldUserId String    @map("field_user_id") @db.Uuid
  fieldUser   FieldUser @relation("FieldEventAuthor", fields: [fieldUserId], references: [id], onDelete: Restrict)

  /// Appareil émetteur — un agent peut changer de tablette, et l'écart entre
  /// l'appareil affecté et l'appareil émetteur est en soi un signal (§ 10.5).
  deviceId String @map("device_id") @db.VarChar(128)

  type    FieldEventType
  /// Charge utile propre à la nature de l'événement. Elle n'est jamais
  /// appliquée telle quelle : le serveur en extrait ce qu'il attend et
  /// délègue aux services de domaine, seuls porteurs des invariants.
  payload Json

  /// Rang dans le journal de l'appareil. L'ORDRE DE PRODUCTION fait foi :
  /// rejouer un lot dans l'ordre d'arrivée réseau appliquerait un relevé de
  /// livraison avant le chargement qui le précède.
  sequence Int @db.Integer

  /// Les DEUX horodatages sont conservés : l'horloge de l'appareil n'est pas
  /// fiable, et l'écart avec la réception serveur est un signal d'audit.
  deviceTimestamp DateTime @map("device_timestamp") @db.Timestamptz(3)
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  status          FieldEventStatus
  /// Motif de refus, rédigé pour l'agent : il redescend sur l'appareil et doit
  /// dire quoi faire, pas seulement que c'est refusé.
  rejectionReason String?   @map("rejection_reason") @db.VarChar(1000)
  appliedAt       DateTime? @map("applied_at") @db.Timestamptz(3)

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  @@index([operationId, sequence])
  @@index([status, receivedAt])
  @@index([fieldUserId, receivedAt])
  @@map("field_sync_events")
}

/// Suppléance. Réf. § 3.4 — l'entreprise n'a qu'un contrôleur HSE ; son
/// indisponibilité bloquerait toute exécution, et l'agent ne peut pas se
/// substituer à lui sans vider le verrou de son sens.
///
/// La suppléance est un ACTE DATÉ ET MOTIVÉ, jamais un droit permanent
/// attaché à un rôle. Elle apparaît au registre des dérogations.
model Delegation {
  id String @id @default(uuid()) @db.Uuid

  /// Rôle dont les prérogatives sont déléguées.
  delegatedRole FieldRole @map("delegated_role")

  grantorId String @map("grantor_id") @db.Uuid
  grantor   User   @relation("DelegationGrantor", fields: [grantorId], references: [id], onDelete: Restrict)

  /// Le suppléant est soit un utilisateur interne (le DG, suppléant de droit),
  /// soit un autre agent terrain. Exactement l'un des deux — CHECK en base.
  delegateUserId      String?    @map("delegate_user_id") @db.Uuid
  delegateUser        User?      @relation("DelegationDelegate", fields: [delegateUserId], references: [id], onDelete: Restrict)
  delegateFieldUserId String?    @map("delegate_field_user_id") @db.Uuid
  delegateFieldUser   FieldUser? @relation("DelegationFieldDelegate", fields: [delegateFieldUserId], references: [id], onDelete: Restrict)

  reason    String   @db.VarChar(1000)
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  derogation Derogation?

  @@index([delegatedRole, startsAt, endsAt])
  @@map("delegations")
}

// ============================================================================
//  TIERS
// ============================================================================

/// Référentiel pays FERMÉ (arbitrage du 15/08) — « pays d'activité seulement »,
/// pas la liste ISO complète : Elyon n'opère pas partout, et une liste
/// ouverte à 249 entrées noierait les quelques pays qui comptent vraiment
/// dans un import Excel ou un menu déroulant.
model Country {
  code String @id @db.Char(2) // ISO 3166-1 alpha-2
  name String @db.VarChar(80)

  isActive Boolean @default(true) @map("is_active")

  partners Partner[]
  sites    Site[]

  @@map("countries")
}

model Partner {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique @db.VarChar(24)
  legalName   String      @map("legal_name") @db.VarChar(200)
  type        PartnerType
  countryCode String      @map("country_code") @db.Char(2) // ISO 3166-1 alpha-2
  country     Country     @relation(fields: [countryCode], references: [code], onDelete: Restrict)

  /// Segment commercial — clients uniquement. Donne le DÉFAUT de formule
  /// de prix et de régime documentaire, jamais la règle (§ 5.1).
  segment CommercialSegment? @map("segment")

  // --- Identification fiscale ivoirienne (§ 6.1) ---
  taxpayerAccountNumber String? @map("taxpayer_account_number") @db.VarChar(32)
  rccmNumber            String? @map("rccm_number") @db.VarChar(48)
  taxRegime             String? @map("tax_regime") @db.VarChar(64)
  isVatExempt           Boolean @default(false) @map("is_vat_exempt")
  /// Référence opposable de l'exonération — obligatoire si exonéré (CHECK).
  vatExemptionReference String? @map("vat_exemption_reference") @db.VarChar(120)

  /// Régime documentaire et fiscal — champ obligatoire du § 9.4,
  /// surchargeable au niveau du Deal (lot 2).
  documentaryRegime DocumentaryRegime @default(PROFORMA_THEN_FNE) @map("documentary_regime")

  /// Institution publique (régie, collectivité, entreprise publique) — commande
  /// le gabarit B2G à la transmission FNE (§ 9.5), distinct de B2B/B2C/B2F.
  isGovernmentInstitution Boolean @default(false) @map("is_government_institution")

  // --- Risque crédit et trésorerie (§ 5.4, § 14.6) ---
  /// Exprimée en devise pivot. Le contrôle crédit ne compare jamais deux devises.
  creditLimit             Decimal      @default(0) @map("credit_limit") @db.Decimal(18, 4)
  /// ⚠️ AUCUN DÉFAUT, ET SURTOUT PAS LE PIVOT.
  ///
  ///    Ce champ valait `USD` par défaut. Conséquence : les quatre clients du
  ///    jeu de démonstration portaient un plafond de crédit libellé en dollars
  ///    sans que personne ne l'ait choisi — « 2 500 000 » pour un client
  ///    ivoirien, ce qui ne veut rien dire tant qu'on ne sait pas dans quelle
  ///    monnaie.
  ///
  ///    Le pivot sert à COMPARER des engagements pris dans des monnaies
  ///    différentes ; il n'est la monnaie de personne. Une donnée financière
  ///    ne s'exprime en dollars que si quelqu'un l'a décidé. La devise du
  ///    plafond se saisit donc, comme le plafond lui-même.
  creditLimitCurrencyCode String       @map("credit_limit_currency_code") @db.Char(3)
  creditLimitCurrency     Currency     @relation("PartnerCreditLimitCurrency", fields: [creditLimitCurrencyCode], references: [code], onDelete: Restrict)
  creditStatus            CreditStatus @default(ACTIVE) @map("credit_status")

  /// Délai d'encaissement accordé. Alimente le calcul du coût de portage
  /// financier (§ 5.4) — 0 = paiement à livraison.
  paymentTermsDays Int @default(0) @map("payment_terms_days") @db.SmallInt
  /// Délai de règlement obtenu — négatif si prépaiement avant livraison,
  /// ce qui est le cas courant côté fournisseurs (§ 14.6).
  supplierTermsDays Int @default(0) @map("supplier_terms_days") @db.SmallInt

  billingCurrencyCode String   @default("XOF") @map("billing_currency_code") @db.Char(3)
  billingCurrency     Currency @relation("PartnerBillingCurrency", fields: [billingCurrencyCode], references: [code], onDelete: Restrict)

  // --- Conformité (§ 6.4) — un fournisseur ou transporteur non conforme
  //     ne peut être affecté sans dérogation du DG.
  isCompliant       Boolean   @default(true) @map("is_compliant")
  complianceCheckedAt DateTime? @map("compliance_checked_at") @db.Timestamptz(3)

  notes    String?  @db.VarChar(2000)
  isActive Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  portalUsers       PortalUser[]
  contacts          PartnerContact[]
  bankAccounts      PartnerBankAccount[]
  complianceRecords ComplianceRecord[]
  vehicles          Vehicle[]
  drivers           Driver[]
  supplierPrices    SupplierPrice[]
  documents         Document[]


  // --- Relations inverses du lot 2 ---
  contracts Contract[] @relation("ContractClient")
  dealsAsClient Deal[] @relation("DealClient")
  operationsAsProductOwner Operation[] @relation("OperationProductOwner")
  assignmentsAsCarrier OperationAssignment[] @relation("AssignmentCarrier")
  purchaseOrders PurchaseOrder[] @relation("PoSupplier")
  measurementsAsInspector MeasurementRecord[] @relation("MeasurementInspector")
  operationCostLines OperationCostLine[] @relation("CostLineSupplier")
  dealCostLines      DealCostLine[]     @relation("DealCostLineSupplier")
  invoices Invoice[] @relation("InvoicePartner")
  payments Payment[] @relation("PaymentPartner")
  supplierInvoices SupplierInvoice[] @relation("SupplierInvoiceSupplier")
  guarantees Guarantee[] @relation("GuaranteePartner")

  @@index([type, isActive])
  @@index([type, creditStatus])
  @@index([segment, isActive])
  @@map("partners")
  carrierTariffs CarrierTariff[] @relation("CarrierTariffPartner")

  crmOpportunities CrmOpportunity[]
  quotationRequests QuotationRequest[]
}

/// Site de livraison ou d'enlèvement. Porte les informations que l'application
/// terrain expose à l'opérateur (§ 10.3) : accès, horaires, consignes de
/// sécurité — jamais de donnée commerciale.
/// SITE — le LIEU PHYSIQUE, indépendant de qui s'y fait livrer ou charger.
///
/// Décision de la direction, 6 août 2026 :
///
///   « Une destination doit être rattachée à un tiers (client) même si
///     plusieurs tiers peuvent avoir la même destination de livraison — et
///     c'est courant. Généralement chaque site de livraison a ses exigences à
///     connaître pour mieux préparer une opération le concernant. »
///
/// ⚠️ POURQUOI LE LIEU EST SÉPARÉ DU RATTACHEMENT.
///
///    `PartnerSite` appartenait à UN tiers. Deux clients livrés au même dépôt
///    minier obligeaient donc à créer le site DEUX FOIS — et avec lui ses
///    consignes d'accès, ses horaires, ses consignes de sécurité. L'une des
///    copies était mise à jour, l'autre non, et l'agent envoyé par le second
///    client partait avec des consignes périmées. Sur un site classé, cela ne
///    se rattrape pas.
///
///    Les exigences appartiennent au LIEU, pas à la relation commerciale.
model Site {
  id   String @id @default(uuid()) @db.Uuid
  /// Code interne d'Elyon pour ce lieu — pas celui d'un client.
  code String @unique @db.VarChar(32)
  name String @db.VarChar(160)

  addressLine String? @map("address_line") @db.VarChar(255)
  city        String? @db.VarChar(120)
  countryCode String  @map("country_code") @db.Char(2)
  country     Country @relation(fields: [countryCode], references: [code], onDelete: Restrict)

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  /// Consignes visibles par le terrain.
  accessInstructions String? @map("access_instructions") @db.VarChar(2000)
  openingHours       String? @map("opening_hours") @db.VarChar(500)
  safetyInstructions String? @map("safety_instructions") @db.VarChar(2000)

  /// Niveau de risque HSE par défaut des opérations sur ce site (§ 7.2).
  defaultHseRiskLevel HseRiskLevel @default(STANDARD) @map("default_hse_risk_level")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Opérations qui en PARTENT.
  operationsAsOrigin Operation[] @relation("OperationOrigin")
  /// Opérations qui y LIVRENT — plusieurs clients au même lieu, et c'est le
  /// cas courant (§ 6.2). Voir la note sur `Operation.destinationSiteId`.
  operationsAsDestination Operation[] @relation("OperationDestination")
  /// Affaires dont ce lieu est la destination.
  deals Deal[]
  tariffsAsOrigin      CarrierTariff[] @relation("CarrierTariffOrigin")
  tariffsAsDestination CarrierTariff[] @relation("CarrierTariffDestination")
  /// Ce qu'il faut savoir avant d'y envoyer quelqu'un.
  requirements SiteRequirement[]

  /// À quoi ce lieu sert. Un dépôt qui reçoit ET expédie porte les deux.
  usages SiteUsage[]

  @@index([isActive, city])
  @@map("sites")
}

/// Nature d'exigence d'un site — ADMINISTRABLE.
///
/// La liste n'est pas figée dans le code : un dépôt impose un badge, un autre
/// un créneau réservé, un troisième un attelage particulier. Ajouter une
/// nature ne doit pas demander une livraison.
model SiteRequirementType {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(48)
  label       String  @db.VarChar(160)
  description String? @db.VarChar(500)

  /// Bloquant PAR DÉFAUT à la création d'une exigence de cette nature. Le
  /// caractère bloquant reste réglable exigence par exigence : un badge
  /// d'accès est bloquant sur un site, une simple recommandation sur un autre.
  defaultBlocking Boolean @default(false) @map("default_blocking")

  displayOrder Int     @default(0) @map("display_order") @db.SmallInt
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  requirements SiteRequirement[]

  @@map("site_requirement_types")
}

/// Une exigence PORTÉE PAR UN SITE — « ce qu'il faut savoir avant d'y aller ».
///
/// Elle est affichée au coordinateur qui prépare l'opération, et à l'agent sur
/// sa tablette. Une exigence BLOQUANTE empêche l'opération d'avancer tant
/// qu'elle n'a pas été acquittée : c'est le même principe que le verrou de
/// conformité — se présenter sans le badge d'accès, c'est repartir à vide.
model SiteRequirement {
  id     String       @id @default(uuid()) @db.Uuid
  siteId String       @map("site_id") @db.Uuid
  site   Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  typeId String              @map("type_id") @db.Uuid
  type   SiteRequirementType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  /// Le détail concret : « badge délivré par le poste de garde, 24 h avant ».
  detail String @db.VarChar(1000)

  /// Bloque l'avancement de l'opération tant qu'elle n'est pas acquittée.
  isBlocking Boolean @default(false) @map("is_blocking")
  isActive   Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Acquittements par opération — une exigence bloquante doit être levée
  /// avant que l'opération avance.
  acknowledgements OperationSiteRequirementAck[]

  @@unique([siteId, typeId])
  @@index([siteId, isActive])
  @@map("site_requirements")
}

/// ACQUITTEMENT d'une exigence de site sur une opération donnée.
///
/// Une exigence bloquante n'est pas une information : c'est une condition. Se
/// présenter sans le badge d'accès ou hors du créneau réservé, c'est un camion
/// qui repart à vide — et le produit est déjà payé, avec son portage.
///
/// L'acquittement dit « c'est fait », et il porte QUI l'a dit : c'est la
/// différence entre une consigne lue et une consigne suivie.
model OperationSiteRequirementAck {
  id String @id @default(uuid()) @db.Uuid

  operationId String    @map("operation_id") @db.Uuid
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  requirementId String                  @map("requirement_id") @db.Uuid
  requirement   SiteRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  /// Ce qui a été fait, concrètement : « badge n° 4471 retiré le 06/08 ».
  note String? @db.VarChar(500)

  acknowledgedById String   @map("acknowledged_by_id") @db.Uuid
  acknowledgedBy   User     @relation("SiteRequirementAck", fields: [acknowledgedById], references: [id], onDelete: Restrict)
  acknowledgedAt   DateTime @default(now()) @map("acknowledged_at") @db.Timestamptz(3)

  @@unique([operationId, requirementId])
  @@map("operation_site_requirement_acks")
}

model PartnerContact {
  id        String  @id @default(uuid()) @db.Uuid
  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  fullName String  @map("full_name") @db.VarChar(160)
  role     String? @db.VarChar(120)
  email    String? @db.VarChar(255)
  phone    String? @db.VarChar(40)
  /// Visible depuis l'application terrain (contact sur place).
  isFieldVisible Boolean @default(false) @map("is_field_visible")
  isPrimary      Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([partnerId])
  @@map("partner_contacts")
}

/// Coordonnées bancaires — exigence du § 6.3 pour les fournisseurs.
model PartnerBankAccount {
  id        String  @id @default(uuid()) @db.Uuid
  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  bankName      String  @map("bank_name") @db.VarChar(160)
  accountNumber String  @map("account_number") @db.VarChar(64)
  iban          String? @db.VarChar(48)
  swiftBic      String? @map("swift_bic") @db.VarChar(16)
  currencyCode  String  @map("currency_code") @db.Char(3)

  isPrimary Boolean  @default(false) @map("is_primary")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([partnerId, isActive])
  @@map("partner_bank_accounts")
}

// ============================================================================
//  PRODUITS
// ============================================================================

model Product {
  id   String @id @default(uuid()) @db.Uuid
  /// Code libre, non énuméré : le catalogue doit pouvoir s'étendre sans migration.
  code String @unique @db.VarChar(32)
  name String @db.VarChar(120)

  /// Densité de référence à 15 °C (kg/L). Base de toute conversion
  /// L ↔ m³ ↔ MT ↔ BBL via les tables ASTM D1250 (§ 6.2).
  ///
  /// NULLE pour un produit SERVICE (`isService`) — une prestation n'a pas de
  /// densité, et rien ne la mesure en volume.
  referenceDensity15 Decimal?      @map("reference_density_15") @db.Decimal(9, 6)
  viscosityCst       Decimal?      @map("viscosity_cst") @db.Decimal(9, 3)
  flashPointC        Decimal?      @map("flash_point_c") @db.Decimal(6, 2)
  maxSulphurPct      Decimal?      @map("max_sulphur_pct") @db.Decimal(6, 4)
  defaultUom         UnitOfMeasure @default(L) @map("default_uom")

  /// Produit SERVICE (ex. barge/soutage) plutôt que produit physique mesuré
  /// en volume. Une affaire qui le retient n'exige ni mode de transport, ni
  /// volume, ni unité — son prix unitaire porte le montant total de la
  /// prestation (§ discussion 15/08).
  isService Boolean @default(false) @map("is_service")

  /// Régime fiscal du produit (§ 6.2).
  taxRegime String? @map("tax_regime") @db.VarChar(64)

  /// Pastille désaturée, canal visuel distinct des couleurs de statut (§ 17.2).
  uiColorToken String @map("ui_color_token") @db.VarChar(32)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  administeredPrices AdministeredPrice[]
  supplierPrices     SupplierPrice[]
  marginThresholds   MarginThreshold[]
  ullageTolerances   UllageTolerance[]
  costStandards      CostStandard[]     @relation("CostStandardProduct")


  // --- Relations inverses du lot 2 ---
  deals Deal[] @relation("DealProduct")

  @@map("products")
  carrierTariffs CarrierTariff[] @relation("CarrierTariffProduct")

  salesForecasts SalesForecast[]

  crmOpportunities CrmOpportunity[]
  quotationRequests QuotationRequest[]
}

// ============================================================================
//  RÉFÉRENCES DE PRIX
//  Réf. § 5.5 — prix administrés DGH/SIR et prix fournisseurs négociés.
// ============================================================================

/// Prix administré — publié par la DGH (prix à la pompe) ou fixé par la SIR.
/// Périodicité VARIABLE : aucune hypothèse de mensualité. Horodaté et
/// historisé, jamais écrasé (§ 5.3).
///
/// RÔLE : simple RÉFÉRENCE consultable au moment de fixer un prix de vente.
/// Le commercial peut s'en servir ou non — le prix de vente reste une valeur
/// qu'il fixe. Aucune décomposition, aucune dérivation automatique : seuls
/// comptent le prix de vente fixé et le prix d'achat réel (§ 5.3).
///
/// ⚠️ N'alimente JAMAIS un coût. Le coût d'achat provient exclusivement d'un
///    SupplierPrice validé.
model AdministeredPrice {
  id String @id @default(uuid()) @db.Uuid

  referenceType PriceReferenceType @map("reference_type") // PUMP ou SIR
  productId     String             @map("product_id") @db.Uuid
  product       Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Zone tarifaire éventuelle (péréquation régionale).
  zone String? @db.VarChar(60)

  price        Decimal       @db.Decimal(18, 4)
  currencyCode String        @map("currency_code") @db.Char(3)
  currency     Currency      @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  uom          UnitOfMeasure

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  /// Référence de l'acte de publication (arrêté, note DGH…).
  publicationReference String? @map("publication_reference") @db.VarChar(200)
  publishedBy          String  @map("published_by") @db.VarChar(60) // DGH, SIR…
  /// Commentaire libre — décomposition indicative, conditions particulières.
  notes String? @db.VarChar(1000)

  recordedById String? @map("recorded_by_id") @db.Uuid
  recordedBy   User?   @relation("AdministeredPriceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)


  // --- Relations inverses du lot 2 ---
  /// Deals ayant consulté cette référence au moment de fixer leur prix.
  deals Deal[]

  @@unique([referenceType, productId, zone, effectiveFrom])
  @@index([referenceType, productId, effectiveFrom(sort: Desc)])
  @@map("administered_prices")
}

/// Prix fournisseur historisé — § 6.3 : dates de validité, source, contrat,
/// validation. Alimente la résolution de référence de prix (§ 5.5).
model SupplierPrice {
  id         String  @id @default(uuid()) @db.Uuid
  supplierId String  @map("supplier_id") @db.Uuid
  supplier   Partner @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId  String  @map("product_id") @db.Uuid
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  unitPrice    Decimal       @map("unit_price") @db.Decimal(18, 4)
  currencyCode String        @map("currency_code") @db.Char(3)
  currency     Currency      @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  uom          UnitOfMeasure

  /// Modalité de fixation : ferme, indexé, formule contractuelle (§ 6.3).
  pricingMethod String  @map("pricing_method") @db.VarChar(80)
  /// Référence du contrat d'approvisionnement.
  contractReference String? @map("contract_reference") @db.VarChar(120)
  /// Source : SIR, GESTOCI, marketeur, autre fournisseur autorisé (§ 6.3).
  sourceLabel String @map("source_label") @db.VarChar(80)

  minVolume    Decimal? @map("min_volume") @db.Decimal(18, 6)

  /// Version éditable de ce prix — un même couple fournisseur/produit peut
  /// être renégocié plusieurs fois ; le numéro se choisit à la création, il
  /// ne s'incrémente pas tout seul. Confort de lecture au tableau, sans effet
  /// sur la sélection : c'est `effectiveFrom`/`effectiveTo` et `isActive` qui
  /// décident ce qui est proposable, jamais le numéro de version.
  version Int @default(1)
  /// Activable/désactivable sans toucher aux dates : un prix qu'on ne veut
  /// plus proposer sans pour autant clore sa période de validité (un
  /// fournisseur suspendu temporairement, par exemple). Une ligne inactive
  /// n'est jamais proposée pour une affaire nouvelle.
  isActive Boolean @default(true) @map("is_active")

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  /// Un prix fournisseur ne s'applique qu'une fois VALIDÉ PAR LE DG (§ 6.3).
  /// Une mise à jour ne modifie jamais une ligne validée : elle en crée une
  /// nouvelle, datée. L'historique des prix d'achat reste donc opposable.
  validatedById String?   @map("validated_by_id") @db.Uuid
  validatedBy   User?     @relation("SupplierPriceValidator", fields: [validatedById], references: [id], onDelete: Restrict)
  validatedAt   DateTime? @map("validated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)


  // --- Relations inverses du lot 2 ---
  purchaseOrders PurchaseOrder[]
  deals          Deal[]         @relation("DealSupplierPrice")

  @@index([supplierId, productId, effectiveFrom(sort: Desc)])
  @@index([productId, validatedAt])
  @@map("supplier_prices")
}

// ============================================================================
//  POSTES DE COÛTS, ABSORPTION ET SEUILS
//  Réf. § 6.5, § 5.4, § 14.2
// ============================================================================

/// Répertoire des postes de coûts — TABLE administrable, jamais une
/// énumération figée : ajouter un poste est du paramétrage, pas une migration.
///
/// ⚠️ NATURE et VARIABILITÉ sont deux axes INDÉPENDANTS, constamment confondus.
///    La plupart des directs sont variables et la plupart des indirects fixes,
///    mais pas tous : une location de dépôt dédiée à un client est directe et
///    fixe ; une commission bancaire proportionnelle est indirecte et variable.
///    Sans le second axe, le point mort (§ 14.5) n'est pas calculable.
///
///    Coûts semi-variables (salaire fixe + prime au voyage) : les SCINDER en
///    deux postes plutôt que modéliser une formule mixte.
model CostPost {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique @db.VarChar(48)
  label String @db.VarChar(160)
  /// Regroupement d'affichage dans les rapports.
  category String @db.VarChar(80)

  nature      CostNature
  variability CostVariability

  /// Pour les postes indirects : regroupement d'absorption (§ 14.2).
  costPoolId String?   @map("cost_pool_id") @db.Uuid
  costPool   CostPool? @relation(fields: [costPoolId], references: [id], onDelete: SetNull)

  /// Pour les postes indirects : assiette de répartition.
  allocationBasis AllocationBasis? @map("allocation_basis")

  /// Poste calculé par le système et non saisi — portage financier, perte
  /// de volume (ullage). Non modifiable manuellement.
  isSystemComputed Boolean @default(false) @map("is_system_computed")

  displayOrder Int     @default(0) @map("display_order") @db.SmallInt
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)


  // --- Relations inverses du lot 2 ---
  operationCostLines OperationCostLine[]
  dealCostLines      DealCostLine[]     @relation("DealCostLinePost")
  costStandards      CostStandard[]     @relation("CostStandardPost")

  @@index([nature, variability])
  @@index([isActive, displayOrder])
  @@map("cost_posts")
}

/// Regroupement de charges indirectes — § 14.2. Un taux unique pour toute
/// l'entreprise ferait subventionner un segment par un autre : le maritime
/// mobilise la barge, le retail les camions.
model CostPool {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique @db.VarChar(48)
  label String @db.VarChar(160)

  allocationBasis AllocationBasis @map("allocation_basis")
  /// Segments couverts. Vide = tous.
  segments CommercialSegment[]

  /// Nature des charges regroupées.
  ///
  /// ⚠️ C'EST CE CHAMP QUI ALIMENTE LE POINT MORT (§ 14.5).
  ///    Les charges fixes de l'exercice sont la SOMME des budgets des pools
  ///    FIXED — elles ne se saisissent plus à part. Un pool VARIABLE (des
  ///    commissions bancaires proportionnelles, par exemple) entre bien dans
  ///    l'absorption, mais pas dans le point mort : il est déjà compté dans la
  ///    marge sur coût variable, et l'y ajouter le compterait deux fois.
  ///
  /// Le défaut n'existe que pour la reprise des pools antérieurs à ce champ ;
  /// il est retiré au niveau de la base juste après, pour qu'aucun pool créé
  /// ensuite ne prenne une nature par omission.
  variability CostVariability @default(FIXED)

  currencyCode String   @map("currency_code") @db.Char(3)
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  costPosts       CostPost[]
  absorptionRates AbsorptionRate[]

  @@map("cost_pools")
}

/// Taux d'absorption d'un regroupement, par exercice.
///
///   Charge indirecte unitaire = Budget annuel ÷ Assiette annuelle BUDGÉTÉE
///
/// ⚠️ LE DÉNOMINATEUR EST BUDGÉTÉ, JAMAIS RÉALISÉ GLISSANT (§ 14.2).
///    Avec un réalisé, une année sous les prévisions ferait monter la charge
///    unitaire — mêmes frais fixes sur moins de litres —, la marge calculée
///    baisserait, davantage d'affaires passeraient sous le seuil, le volume
///    baisserait encore. Sur une marge de l'ordre de 4 %, l'effet est violent.
///    Le budget figé neutralise cette boucle ; l'écart devient une variance
///    analysée en fin d'exercice.
model AbsorptionRate {
  id         String   @id @default(uuid()) @db.Uuid
  costPoolId String   @map("cost_pool_id") @db.Uuid
  costPool   CostPool @relation(fields: [costPoolId], references: [id], onDelete: Cascade)

  /// L'exercice comptable, par référence.
  ///
  /// ⚠️ C'ÉTAIT UN ENTIER LIBRE, SANS CLÉ ÉTRANGÈRE.
  ///    On pouvait saisir un taux pour un exercice qui n'existe pas — 2027 non
  ///    déclaré, ou 2062 par faute de frappe. Rien ne bronchait, et le taux
  ///    disparaissait simplement de tous les calculs. Les trois autres données
  ///    budgétaires pointaient correctement vers l'exercice ; seule celle-ci
  ///    était restée en arrière, écrite avant que la table n'existe.
  fiscalYearId String     @map("fiscal_year_id") @db.Uuid
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  /// Budget annuel des charges du regroupement, en devise du pool.
  /// SEULE VALEUR SAISIE de ce modèle — tout le reste en découle.
  budgetedAmount Decimal @map("budgeted_amount") @db.Decimal(18, 4)

  /// Assiette annuelle budgétée.
  ///
  /// ⚠️ CALCULÉE, PLUS SAISIE — somme des volumes de PRÉVISION BUDGÉTÉE de
  ///    l'exercice, sur les segments que le pool couvre (§ 14.2, § 14.3).
  ///    La saisir une seconde fois garantissait qu'un jour les deux
  ///    divergeraient. Les défauts n'existent que pour que Prisma ne les
  ///    exige pas à la création : le déclencheur les écrase aussitôt.
  budgetedBase Decimal        @default(0) @map("budgeted_base") @db.Decimal(18, 6)
  baseUom      UnitOfMeasure? @map("base_uom")

  /// Taux dérivé = budgetedAmount / budgetedBase. Figé, recalculé
  /// uniquement lors d'une révision explicite.
  /// CALCULÉ par déclencheur — budget ÷ assiette. Le défaut n'existe que
  /// pour que Prisma ne l'exige pas à la création : il est écrasé aussitôt.
  ratePerUnit Decimal @default(0) @map("rate_per_unit") @db.Decimal(18, 6)

  /// Version : une révision crée une nouvelle ligne, jamais un écrasement.
  version   Int      @default(1) @db.SmallInt
  isCurrent Boolean  @default(true) @map("is_current")
  notes     String?  @db.VarChar(1000)

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation("AbsorptionRateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([costPoolId, fiscalYearId, version])
  @@index([costPoolId, fiscalYearId, isCurrent])
  @@map("absorption_rates")
}

/// Grille des seuils de marge — § 5.4. Segment et produit déterminent le
/// montant, la devise ET l'unité : le soutage se traite en tonnes, le retail
/// en litres.
///
///   Plancher direct → BLOCAGE DUR, levée par le DG seul, justification
///                     écrite, catégorie distincte au registre des dérogations.
///   Seuil minimum   → PENDING_DG_APPROVAL, accord DG avec motif, PAS un refus.
model MarginThreshold {
  id String @id @default(uuid()) @db.Uuid

  segment   CommercialSegment
  productId String?           @map("product_id") @db.Uuid
  product   Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Marge après charges directes seules, portage inclus. Blocage dur.
  directFloor Decimal? @map("direct_floor") @db.Decimal(18, 4)
  /// Marge après charges complètes, indirectes absorbées incluses.
  minimumMargin Decimal? @map("minimum_margin") @db.Decimal(18, 4)

  currencyCode String   @map("currency_code") @db.Char(3)
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  uom          UnitOfMeasure

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  /// Coupure indépendante de la date de validité (§ 1.1 bis) : un seuil peut
  /// être suspendu sans être réputé expiré, et réactivé sans nouvelle ligne.
  isActive Boolean @default(true) @map("is_active")

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation("MarginThresholdAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// La devise ET l'unité entrent dans la clé : un même segment peut porter
  /// un seuil en XOF/L pour la distribution et un autre en USD/MT pour le
  /// soutage, sans que l'un chasse l'autre.
  @@unique([segment, productId, currencyCode, uom, effectiveFrom])
  @@index([segment, currencyCode, uom, effectiveFrom(sort: Desc)])
  @@map("margin_thresholds")
}

/// Grille de tolérance d'écart de volume — § 8.3.
///
/// ⚠️ Ces tolérances ne sont PAS des valeurs physiques universelles. Elles
///    sont CONTRACTUELLES : les contrats de transport en stipulent la
///    franchise et qui la supporte, les polices d'assurance définissent le
///    seuil indemnisable. Les normes ASTM et API définissent comment mesurer,
///    pas combien de perte est acceptable.
///
/// Initialisées à 0,2 % partout, à calibrer contrat par contrat.
model UllageTolerance {
  id String @id @default(uuid()) @db.Uuid

  segment       CommercialSegment?
  transportMode TransportMode?     @map("transport_mode")
  productId     String?            @map("product_id") @db.Uuid
  product       Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// En deçà : perte technique attendue, aucune alerte.
  normalThresholdPct Decimal @map("normal_threshold_pct") @db.Decimal(9, 6)
  /// Au-delà : alerte + acquittement motivé attendu. Sans effet sur la
  /// facturation — l'ullage est un capteur opérationnel, pas un verrou commercial.
  alertThresholdPct Decimal @map("alert_threshold_pct") @db.Decimal(9, 6)
  /// Au-delà : blocage + NON-CONFORMITÉ HSE OUVERTE D'OFFICE.
  /// Un écart important signifie que le produit est allé quelque part :
  /// fuite, déversement ou détournement — les trois relèvent du HSE.
  criticalThresholdPct Decimal @map("critical_threshold_pct") @db.Decimal(9, 6)

  /// Volume plancher sous lequel aucun seuil ne se déclenche — évite les
  /// alertes sur arrondi pour les petites opérations.
  absoluteFranchise Decimal?      @map("absolute_franchise") @db.Decimal(18, 6)
  franchiseUom      UnitOfMeasure? @map("franchise_uom")

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  /// Coupure indépendante de la date de validité (§ 1.1 bis) : une grille peut
  /// être suspendue sans être réputée expirée, et réactivée sans nouvelle ligne.
  isActive Boolean @default(true) @map("is_active")

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation("UllageToleranceAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Relevés ayant appliqué cette grille — la tolérance est figée au moment
  /// du relevé, une révision ultérieure ne requalifie pas un écart acquitté.
  measurements MeasurementRecord[]

  @@index([segment, transportMode, productId])
  @@map("ullage_tolerances")
}

// ============================================================================
//  TRANSPORT & CONFORMITÉ DES MOYENS
//  Réf. § 6.4 — un sous-traitant, véhicule ou chauffeur non conforme ne peut
//  être affecté sans dérogation formalisée DU DG.
// ============================================================================

model Vehicle {
  id        String  @id @default(uuid()) @db.Uuid
  /// Transporteur propriétaire. Nul = moyen propre à Elyon.
  carrierId String? @map("carrier_id") @db.Uuid
  carrier   Partner? @relation(fields: [carrierId], references: [id], onDelete: Restrict)

  registration String      @unique @db.VarChar(40)
  type         VehicleType
  brandModel   String?     @map("brand_model") @db.VarChar(120)
  year         Int?        @db.SmallInt

  /// Capacité totale et nombre de compartiments — le compartimentage
  /// conditionne le contrôle produit au chargement (§ 7.4).
  capacity        Decimal       @db.Decimal(18, 6)
  capacityUom     UnitOfMeasure @map("capacity_uom")
  compartmentCount Int?         @map("compartment_count") @db.SmallInt

  /// Produits autorisés à bord — un véhicule ayant transporté de l'essence
  /// n'accepte pas indifféremment un autre produit.
  allowedProductIds String[] @map("allowed_product_ids") @db.Uuid

  /// Recalculé depuis les pièces de conformité. Faux ⇒ affectation refusée
  /// sans dérogation DG (invariant § 11.3).
  isCompliant       Boolean   @default(false) @map("is_compliant")
  complianceCheckedAt DateTime? @map("compliance_checked_at") @db.Timestamptz(3)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  complianceRecords ComplianceRecord[]


  // --- Relations inverses du lot 2 ---
  assignments OperationAssignment[]
  /// Maintenance (§ 13 module 7) — une barge en est un objet au même titre
  /// qu'un camion ou un navire ; le modèle n'est pas dupliqué pour elle.
  maintenanceEvents VehicleMaintenanceEvent[]

  @@index([carrierId, isActive])
  @@index([isCompliant, isActive])
  @@map("vehicles")
}

enum VehicleMaintenanceType {
  PREVENTIVE
  CORRECTIVE
  REGULATORY // Contrôle technique, certification périodique.

  @@map("vehicle_maintenance_type")
}

/// Maintenance d'un moyen (§ 13 module 7 : « objet de maintenance »).
/// Générique à tout `Vehicle`, barge comprise (`type = BUNKER_BARGE`) — un
/// second modèle dédié dupliquerait immatriculation, conformité, capacité.
model VehicleMaintenanceEvent {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type        VehicleMaintenanceType
  description String                 @db.VarChar(1000)

  cost         Decimal  @default(0) @db.Decimal(18, 4)
  currencyCode String   @map("currency_code") @db.Char(3)
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  performedAt DateTime  @map("performed_at") @db.Date
  /// Prochaine échéance — révision programmée, contrôle technique à renouveler.
  nextDueAt   DateTime? @map("next_due_at") @db.Date
  performedBy String?   @map("performed_by") @db.VarChar(160)

  recordedById String? @map("recorded_by_id") @db.Uuid
  recordedBy   User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([vehicleId, performedAt(sort: Desc)])
  @@index([nextDueAt])
  @@map("vehicle_maintenance_events")
}

/// Chauffeur. N'est PAS un utilisateur du système (§ 2) : il relève de la
/// responsabilité de l'agent d'opération. Il est une donnée de conformité
/// et un signataire, jamais un compte.
model Driver {
  id        String   @id @default(uuid()) @db.Uuid
  carrierId String?  @map("carrier_id") @db.Uuid
  carrier   Partner? @relation(fields: [carrierId], references: [id], onDelete: Restrict)

  fullName       String  @map("full_name") @db.VarChar(160)
  employeeNumber String? @map("employee_number") @db.VarChar(48)
  idDocumentType String? @map("id_document_type") @db.VarChar(60)
  idDocumentRef  String? @map("id_document_ref") @db.VarChar(64)
  phone          String? @db.VarChar(40)

  isCompliant         Boolean   @default(false) @map("is_compliant")
  complianceCheckedAt DateTime? @map("compliance_checked_at") @db.Timestamptz(3)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  complianceRecords ComplianceRecord[]


  // --- Relations inverses du lot 2 ---
  assignments OperationAssignment[]
  signatures Signature[]

  @@index([carrierId, isActive])
  @@index([isCompliant, isActive])
  @@map("drivers")
}

/// Pièce de conformité à échéance — agrément, assurance, contrôle technique,
/// permis, habilitation. Se rattache à EXACTEMENT un porteur : tiers,
/// véhicule ou chauffeur (CHECK en base).
///
/// C'est le socle du verrou de conformité et du moteur d'alerte : cette table
/// seule a déjà de la valeur avant tout le reste de l'ERP.
model ComplianceRecord {
  id   String         @id @default(uuid()) @db.Uuid
  type ComplianceType

  partnerId String?  @map("partner_id") @db.Uuid
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  vehicleId String?  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId  String?  @map("driver_id") @db.Uuid
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  reference   String  @db.VarChar(120)
  issuingBody String? @map("issuing_body") @db.VarChar(160)

  issueDate  DateTime  @map("issue_date") @db.Date
  expiryDate DateTime? @map("expiry_date") @db.Date

  status ComplianceStatus @default(VALID)
  /// Bloque l'affectation si expirée ou suspendue. Une formation facultative
  /// peut être suivie sans être bloquante.
  isBlocking Boolean @default(true) @map("is_blocking")

  /// Justificatif archivé en GED.
  documentId String?   @map("document_id") @db.Uuid
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  expiryAlertSentAt DateTime? @map("expiry_alert_sent_at") @db.Timestamptz(3)

  recordedById String? @map("recorded_by_id") @db.Uuid
  recordedBy   User?   @relation("ComplianceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([type, expiryDate])
  @@index([status, isBlocking])
  @@index([partnerId, status])
  @@index([vehicleId, status])
  @@index([driverId, status])
  @@map("compliance_records")
}

/// Agréments et licences d'ELYON TRADING ELLE-MÊME — jamais un tiers, un
/// véhicule ou un chauffeur (voir `ComplianceRecord`, qui exige au contraire
/// EXACTEMENT un de ces trois porteurs). Agrément douanier, agrément
/// ministériel, licence import/export : ce que l'entreprise doit détenir
/// pour opérer, distinct de ce que ses sous-traitants et leurs moyens
/// doivent détenir pour être affectés.
model CompanyAccreditation {
  id   String         @id @default(uuid()) @db.Uuid
  type ComplianceType

  reference   String  @db.VarChar(120)
  issuingBody String? @map("issuing_body") @db.VarChar(160)

  issueDate  DateTime  @map("issue_date") @db.Date
  expiryDate DateTime? @map("expiry_date") @db.Date

  /// Projection du dernier calcul, comme sur `ComplianceRecord` — la vue de
  /// suivi refait le calcul à la lecture, cette colonne ne sert que d'index
  /// et d'affichage (§ compliance_statut_effectif, réutilisée telle quelle).
  status ComplianceStatus @default(VALID)

  documentId String?   @map("document_id") @db.Uuid
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  expiryAlertSentAt DateTime? @map("expiry_alert_sent_at") @db.Timestamptz(3)

  recordedById String? @map("recorded_by_id") @db.Uuid
  recordedBy   User?   @relation("CompanyAccreditationRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([type, expiryDate])
  @@map("company_accreditations")
}

// ============================================================================
//  HSE — MODÈLES DE CONTRÔLE (paramétrage)
//  Réf. § 7 — les checklists sont extensibles SANS développement.
//  Les instances de contrôle arrivent au lot 2, avec l'Opération.
// ============================================================================

/// TYPE D'OPÉRATION — administrable, et indexant les contrôles HSE (§ 7.1).
///
/// Une opération en porte PLUSIEURS : elle commence par un transport routier
/// et se termine par un soutage à quai. Les contrôles applicables sont donc
/// l'UNION de ceux de chaque type, dédoublonnée. Un type unique aurait obligé
/// à créer un type composite par combinaison rencontrée — ingérable dès la
/// troisième.
///
/// Aucune valeur n'est codée en dur : la liste se tient depuis l'écran de
/// paramétrage, comme les seuils et les barèmes (§ 1.1 bis).
model OperationType {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique @db.VarChar(48)
  label String @db.VarChar(160)

  /// Précision opérationnelle affichée au moment de composer l'opération.
  description String? @db.VarChar(500)

  /// Segments où ce type a un sens. Vide = tous.
  segments CommercialSegment[]

  /// Niveau de risque par défaut, proposé à la création. Il reste modifiable :
  /// c'est une aide à la saisie, pas une contrainte.
  defaultRiskLevel HseRiskLevel? @map("default_risk_level")

  displayOrder Int     @default(0) @map("display_order") @db.SmallInt
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  operations OperationTypeAssignment[]
  checklists HseChecklistTemplate[]   @relation("ChecklistOperationTypes")
  procedure  OperationalProcedure?

  @@index([isActive, displayOrder])
  @@map("operation_types")
}

/// Procédure opérationnelle d'un type d'opération (§ discussion 20/08).
///
/// Éditée par l'Assistante de Direction, lisible par tous les rôles internes :
/// ce n'est pas une donnée sensible, c'est un mode opératoire que l'ensemble
/// de l'entreprise doit pouvoir consulter avant d'exécuter. Une ligne par
/// type d'opération, jamais plusieurs — une procédure qui se reprend REMPLACE
/// la précédente, elle ne s'empile pas à côté.
model OperationalProcedure {
  id              String       @id @default(uuid()) @db.Uuid
  operationTypeId String       @unique @map("operation_type_id") @db.Uuid
  operationType   OperationType @relation(fields: [operationTypeId], references: [id], onDelete: Cascade)

  content String @db.Text

  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("operational_procedures")
}

/// Rattachement d'un type à une opération, avec son rang dans le déroulé.
///
/// L'ordre compte : il dit dans quelle succession les étapes s'enchaînent, et
/// donc dans quel ordre les checklists se présentent à l'agent.
model OperationTypeAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  operationId String    @map("operation_id") @db.Uuid
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  operationTypeId String        @map("operation_type_id") @db.Uuid
  operationType   OperationType @relation(fields: [operationTypeId], references: [id], onDelete: Restrict)

  /// Rang dans le déroulé — 1 pour le transport routier, 2 pour le soutage.
  sequence Int @default(1) @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([operationId, operationTypeId])
  @@index([operationId, sequence])
  @@map("operation_type_assignments")
}

model HseChecklistTemplate {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique @db.VarChar(48)
  label String @db.VarChar(200)

  /// TYPES D'OPÉRATION couverts — l'axe principal d'indexation (§ 7.1).
  /// Une opération portant plusieurs types reçoit l'union de leurs checklists.
  operationTypes OperationType[] @relation("ChecklistOperationTypes")

  /// Axes d'affinage, conservés : ils permettent de distinguer deux checklists
  /// du même type d'opération selon le segment ou le niveau de risque. Vide =
  /// s'applique à tous.
  applicableSegments      CommercialSegment[] @map("applicable_segments")
  applicableTransportModes TransportMode[]    @map("applicable_transport_modes")
  applicableRiskLevels    HseRiskLevel[]      @map("applicable_risk_levels")

  version   Int     @default(1) @db.SmallInt
  isCurrent Boolean @default(true) @map("is_current")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items HseChecklistItem[]


  // --- Relations inverses du lot 2 ---
  operationChecks OperationHseCheck[]
  /// Points effectivement issus de ce modèle — la provenance se lit ici, la
  /// checklist d'une opération multi-types n'ayant pas de modèle unique.
  sourcedCheckItems OperationHseCheckItem[] @relation("CheckItemSource")

  @@index([isActive, isCurrent])
  @@map("hse_checklist_templates")
}

model HseChecklistItem {
  id         String               @id @default(uuid()) @db.Uuid
  templateId String               @map("template_id") @db.Uuid
  template   HseChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  code  String @db.VarChar(48)
  label String @db.VarChar(300)
  /// Précision opérationnelle affichée sur la tablette.
  guidance String? @db.VarChar(1000)

  phase OperationPhase
  level HseControlLevel

  /// Régime photographique du point — TROIS états, administrables (§ 7.1 bis).
  ///
  /// ⚠️ `requiresPhoto` seul ne suffisait pas, et pour deux raisons.
  ///
  ///    D'abord parce qu'un booléen ne distingue pas « facultative » de
  ///    « interdite » : l'application proposait donc l'appareil photo partout,
  ///    ce qui est une décision métier qu'elle n'avait pas à prendre. La prise
  ///    de vue est proscrite en zone ATEX, sur certains dépôts et chez des
  ///    clients qui l'interdisent contractuellement — un bouton affiché là met
  ///    l'agent en faute.
  ///
  ///    Ensuite parce que `requiresPhoto` n'était vérifié NULLE PART : ni par
  ///    l'application, ni par la base. Un point marqué « photo exigée »
  ///    s'enregistrait sans photo, et personne ne le voyait. Le paramètre
  ///    existait, s'affichait à l'écran, et ne commandait rien.
  ///
  /// Décision de la direction du 6 août 2026 : l'exigence mord À
  /// L'ENREGISTREMENT du point, pas à la validation de la checklist.
  photoPolicy HsePhotoPolicy @default(OPTIONAL) @map("photo_policy")

  /// Conservé et TENU À JOUR avec `photoPolicy` par un déclencheur : les
  /// tablettes et les vues existantes le lisent encore. Il sera retiré quand
  /// plus rien ne le lira.
  requiresPhoto     Boolean @default(false) @map("requires_photo")
  requiresValue     Boolean @default(false) @map("requires_value")
  valueLabel        String? @map("value_label") @db.VarChar(120)
  requiresSignature Boolean @default(false) @map("requires_signature")

  displayOrder Int     @default(0) @map("display_order") @db.SmallInt
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)


  // --- Relations inverses du lot 2 ---
  results OperationHseCheckItem[]

  @@unique([templateId, code])
  @@index([templateId, phase, displayOrder])
  @@map("hse_checklist_items")
}

// ============================================================================
//  GED
// ============================================================================

/// Coffre-fort documentaire. Le binaire n'est JAMAIS en base : seuls la clé
/// de stockage objet et l'empreinte SHA-256 qui en garantit l'intégrité.
model Document {
  id   String       @id @default(uuid()) @db.Uuid
  type DocumentType

  title      String @db.VarChar(255)
  storageKey String @unique @map("storage_key") @db.VarChar(512)
  mimeType   String @map("mime_type") @db.VarChar(120)
  sizeBytes  BigInt @map("size_bytes")
  sha256     String @db.Char(64)

  partnerId String?  @map("partner_id") @db.Uuid
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  expiryDate        DateTime? @map("expiry_date") @db.Date
  expiryAlertSentAt DateTime? @map("expiry_alert_sent_at") @db.Timestamptz(3)

  /// Faux par défaut : rien n'est exposé au client sans décision explicite.
  isClientVisible Boolean @default(false) @map("is_client_visible")
  /// Visible depuis l'application terrain (ordre de mission, FDS, autorisations).
  isFieldVisible Boolean @default(false) @map("is_field_visible")

  uploadedById String? @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  complianceRecords ComplianceRecord[]
  companyAccreditations CompanyAccreditation[]

  @@index([type, expiryDate])
  @@index([partnerId, type])
  @@map("documents")
}

// ============================================================================
//  REGISTRE DES DÉROGATIONS
//  Réf. § 11.4 — registre UNIQUE pour les quatre verrous et la suppléance.
//  C'est ce qu'un auditeur ou un assureur demandera à consulter après un
//  incident.
// ============================================================================

model Derogation {
  id   String         @id @default(uuid()) @db.Uuid
  type DerogationType

  /// Objet dérogé, désigné de façon lâche : les entités concernées
  /// (Deal, Opération) arrivent au lot 2. Type + identifiant textuel.
  subjectType String  @map("subject_type") @db.VarChar(64)
  subjectId   String? @map("subject_id") @db.VarChar(64)
  subjectLabel String? @map("subject_label") @db.VarChar(255)

  requestedById String? @map("requested_by_id") @db.Uuid
  requestedBy   User?   @relation("DerogationRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  /// Autorité qui accorde. Contrainte de rôle vérifiée en base selon le type :
  /// TRANSPORT_NON_COMPLIANCE et MARGIN_BELOW_DIRECT_FLOOR ⇒ DG exclusivement.
  authorityId String @map("authority_id") @db.Uuid
  authority   User   @relation("DerogationAuthority", fields: [authorityId], references: [id], onDelete: Restrict)

  /// Motif écrit obligatoire — longueur minimale vérifiée en base.
  reason String @db.VarChar(2000)

  status    DerogationStatus @default(ACTIVE)
  grantedAt DateTime         @default(now()) @map("granted_at") @db.Timestamptz(3)
  expiresAt DateTime?        @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime?        @map("revoked_at") @db.Timestamptz(3)
  closedAt  DateTime?        @map("closed_at") @db.Timestamptz(3)

  /// Signalée à la revue mensuelle — vrai pour les dérogations exceptionnelles
  /// (franchissement du plancher direct notamment).
  requiresMonthlyReview Boolean   @default(false) @map("requires_monthly_review")
  reviewedAt            DateTime? @map("reviewed_at") @db.Timestamptz(3)

  /// Lien vers la suppléance lorsque la dérogation en est une.
  delegationId String?     @unique @map("delegation_id") @db.Uuid
  delegation   Delegation? @relation(fields: [delegationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)


  // --- Relations inverses du lot 2 ---
  dealMargin Deal? @relation("DealMarginDerogation")
  dealPurchasePrice Deal? @relation("DealPurchasePriceDerogation")
  dealCredit Deal? @relation("DealCreditDerogation")
  operationHse Operation? @relation("OperationHseDerogation")
  assignment OperationAssignment? @relation("AssignmentDerogation")
  ullage MeasurementRecord? @relation("UllageDerogation")

  @@index([type, status, grantedAt])
  @@index([subjectType, subjectId])
  @@index([requiresMonthlyReview, reviewedAt])
  @@map("derogations")
}

// ============================================================================
//  SOCLE TECHNIQUE
// ============================================================================

/// Journal d'audit APPEND-ONLY. UPDATE et DELETE bloqués par trigger
/// PostgreSQL et refusés au rôle applicatif erp_app (§ 1.4).
model AuditLog {
  id BigInt @id @default(autoincrement())

  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  actorLabel String?   @map("actor_label") @db.VarChar(255)

  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(64)
  entityId   String?     @map("entity_id") @db.VarChar(64)

  beforeState Json? @map("before_state")
  afterState  Json? @map("after_state")

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Paramètres métier modifiables sans redéploiement — taux de financement,
/// devise pivot, préavis d'alerte, taux de TVA, activation FNE…
model SystemSetting {
  key         String   @id @db.VarChar(64)
  value       String   @db.VarChar(1000)
  valueType   String   @map("value_type") @db.VarChar(16) // string | number | boolean | json
  description String   @db.VarChar(500)
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

/// VISIBLE = accordé même hors du rôle natif. MASQUE = retiré même à un rôle
/// qui y aurait droit nativement. L'absence de ligne = comportement par
/// défaut du code (aucune dérogation).
enum ScreenAccessOverride {
  VISIBLE
  MASQUE

  @@map("screen_access_override")
}

/// Dérogations DG à la visibilité des écrans par rôle (§ paramétrage 17/08).
///
/// ⚠️ CE N'EST PAS UNE TABLE DE PERMISSIONS D'ACTION.
///
///    Elle ne gouverne QUE la visibilité en LECTURE d'un écran - ce qui rend
///    un menu et sa route ouvrables. Les actions (créer, approuver,
///    supprimer...) restent décidées par `@Roles()` sur chaque route, en dur
///    dans le code, et cette table n'a AUCUNE prise dessus. Un rôle qui
///    obtient ainsi la vue d'un écran voit ses données ; les boutons d'action
///    que son rôle ne permet pas restent bloqués exactement comme avant.
///    Mélanger les deux aurait transformé un réglage de confort en porte
///    dérobée vers des droits d'écriture que personne n'a validés.
model RoleScreenAccess {
  id          String               @id @default(uuid()) @db.Uuid
  role        UserRole
  screenKey   String               @map("screen_key") @db.VarChar(64)
  override    ScreenAccessOverride
  updatedById String?              @map("updated_by_id") @db.Uuid
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([role, screenKey])
  @@map("role_screen_access")
}

/// Générateur de références séquentielles sans trou. L'incrément se fait
/// sous SELECT ... FOR UPDATE dans la transaction métier — jamais en mémoire
/// applicative, sous peine de collision ou de trou.
///
/// Portées : CONTRACT · DEAL · OPERATION · PROFORMA · INVOICE_SIMPLE ·
///           INVOICE_FNE · CREDIT_NOTE · PO · MEASUREMENT · QUOTATION
model NumberSequence {
  id        String @id @default(uuid()) @db.Uuid
  scope     String @db.VarChar(32)
  year      Int    @db.SmallInt
  /// 0 pour une séquence annuelle (OP-2026-000154), 1-12 pour une séquence
  /// mensuelle (DEAL-2026-08-001).
  month     Int    @db.SmallInt
  lastValue Int    @default(0) @map("last_value")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([scope, year, month])
  @@map("number_sequences")
}

// ############################################################################
// #                                                                          #
// #   LOT 2 — CŒUR COMMERCIAL & EXÉCUTION                                    #
// #   Contrat → Deal → Opération · les 3 verrous · HSE · relevés ·           #
// #   facturation · documents signés                                         #
// #                                                                          #
// #   Réf. SPECIFICATIONS.md § 4, § 5, § 7, § 8, § 9, § 11, § 12             #
// #                                                                          #
// ############################################################################

// ============================================================================
//  ÉNUMÉRATIONS DU LOT 2
// ============================================================================

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  TERMINATED

  @@map("contract_status")
}

/// Machine à états du Deal — niveau commercial et financier (§ 4.2).
enum DealStatus {
  DRAFT
  FEASIBILITY_STUDY
  QUOTED
  PENDING_RISK
  CREDIT_BLOCKED
  PENDING_DG_APPROVAL
  APPROVED
  PROFORMA_SENT
  CUSTOMER_ACCEPTED
  REJECTED_BY_CLIENT
  IN_EXECUTION
  DELIVERED
  PARTIALLY_DELIVERED
  QUALITY_CLAIM
  INVOICED
  DISPUTED
  CLOSED
  CANCELLED

  @@map("deal_status")
}

/// Machine à états de l'Opération — niveau exécution physique (§ 4.3).
enum OperationStatus {
  DRAFT
  SOURCING
  HSE_PREPARATION
  HSE_BLOCKED
  PLANNED
  LOADING
  IN_TRANSIT
  DELIVERING
  FINAL_CHECK
  CLOSED
  INCIDENT
  CANCELLED

  @@map("operation_status")
}

/// Mode d'approvisionnement (§ 4.4). Le back-to-back n'est plus une propriété
/// du système mais un attribut de l'opération.
enum SourcingMode {
  BACK_TO_BACK // Achat dédié, sans stock. Relation 1-to-1 avec la commande.
  FROM_STOCK // Prélèvement sur stock détenu. Modélisé, activé ultérieurement.
  THIRD_PARTY_PRODUCT // Produit du client. Jamais valorisé. Seule la prestation est facturée.

  @@map("sourcing_mode")
}

/// Mode d'expression d'une réduction commerciale (§ 5.2).
/// Mode d'expression d'une réduction commerciale.
enum DiscountMode {
  PER_UNIT // Montant par litre / tonne
  PERCENTAGE
  FIXED_AMOUNT // Remise globale en montant

  @@map("discount_mode")
}

/// Mention HT / TTC imprimée en entête de la pièce.
///
/// PUREMENT DOCUMENTAIRE : elle n'a aucun effet sur le calcul des montants.
/// Le prix saisi est toujours toutes taxes, et la TVA — si la case
/// « TVA applicable » est cochée — s'extrait du total.
enum TaxRegime {
  HT
  TTC

  @@map("tax_regime")
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  CONFIRMED
  FULFILLED
  CANCELLED

  @@map("purchase_order_status")
}

/// Valeur probante d'un relevé de volume (§ 8.1).
enum MeasurementSource {
  INDEPENDENT_INSPECTION // Inspecteur tiers assermenté — valeur la plus forte
  CONTRADICTORY // Contrôleur HSE Elyon + représentant client
  SELF_MEASURED // Auto-mesure — valeur probante faible

  @@map("measurement_source")
}

enum HseCheckOutcome {
  PENDING
  PASSED
  FAILED
  NOT_APPLICABLE

  @@map("hse_check_outcome")
}

enum HseEventType {
  INCIDENT
  ACCIDENT
  SPILL
  NEAR_MISS
  DANGEROUS_OBSERVATION
  NON_CONFORMITY

  @@map("hse_event_type")
}

enum HseSeverity {
  MINOR
  MODERATE
  MAJOR
  CRITICAL

  @@map("hse_severity")
}

enum HseEventStatus {
  OPEN
  UNDER_INVESTIGATION
  ACTION_IN_PROGRESS
  CLOSED

  @@map("hse_event_status")
}

/// Typologie documentaire (§ 9.3).
enum InvoiceType {
  PROFORMA
  SIMPLE // Facture simple, sans transmission FNE
  FNE // Facture normalisée électronique
  CREDIT_NOTE

  @@map("invoice_type")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  DISPUTED
  CANCELLED

  @@map("invoice_status")
}

/// Mode de règlement déclaré à la FNE (§ 9.5) — vocabulaire imposé par la
/// DGI, pas une liste ouverte : ajouter une valeur casserait la transmission.
enum InvoicePaymentMethod {
  CASH
  CARD
  CHECK
  MOBILE_MONEY
  TRANSFER
  DEFERRED

  @@map("invoice_payment_method")
}

/// Cycle de vie fiscal de la FNE (§ 9.5).
enum FneStatus {
  NOT_APPLICABLE
  DRAFT
  TO_VALIDATE
  PENDING_TRANSMISSION
  TRANSMITTED
  ACCEPTED
  REJECTED
  TO_CORRECT
  CANCELLED

  @@map("fne_status")
}

enum PaymentDirection {
  INBOUND // Encaissement client
  OUTBOUND // Règlement fournisseur, transporteur, inspecteur

  @@map("payment_direction")
}

enum SupplierInvoiceStatus {
  EXPECTED // Attendue — prépaiement déjà sorti (§ 14.6)
  RECEIVED
  APPROVED
  PAID
  DISPUTED
  CANCELLED

  @@map("supplier_invoice_status")
}

enum GuaranteeType {
  LETTER_OF_CREDIT
  DOWN_PAYMENT
  BANK_GUARANTEE

  @@map("guarantee_type")
}

enum GuaranteeStatus {
  PENDING
  ACTIVE
  CONSUMED
  EXPIRED
  CANCELLED

  @@map("guarantee_status")
}

/// Nature d'un signataire (§ 12.3). Tous ne sont pas utilisateurs du système :
/// le chauffeur et le représentant du client signent sans avoir de compte.
enum SignatoryKind {
  INTERNAL_USER
  FIELD_USER
  PORTAL_USER
  DRIVER
  CLIENT_REPRESENTATIVE
  INSPECTOR
  OTHER_EXTERNAL

  @@map("signatory_kind")
}

enum GeneratedDocumentKind {
  PROFORMA
  INVOICE
  CREDIT_NOTE
  DELIVERY_NOTE // Bon de livraison — signé sur site
  OPERATION_REPORT // Rapport d'exécution — signé à la clôture
  TRANSPORT_ORDER
  MEASUREMENT_REPORT

  @@map("generated_document_kind")
}

// ============================================================================
//  HIÉRARCHIE MÉTIER — CONTRAT → DEAL → OPÉRATION
//  Réf. SPECIFICATIONS.md § 4.1
//
//  Les quatorze étapes du cahier de cadrage ne forment pas une machine unique :
//  le flux part du commercial, descend dans l'exécution physique, puis remonte
//  au commercial. Deux niveaux, deux machines à états — c'est ce qui rend au
//  verrou financier un point de contrôle unique.
// ============================================================================

/// Accord-cadre. FACULTATIF : un Deal peut exister sans contrat.
/// Utile en B2B et Retail, où un même client est livré de façon récurrente.
model Contract {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique @db.VarChar(24) // CTR-2026-014

  clientId String  @map("client_id") @db.Uuid
  client   Partner @relation("ContractClient", fields: [clientId], references: [id], onDelete: Restrict)

  title  String         @db.VarChar(200)
  status ContractStatus @default(DRAFT)

  /// Conditions négociées, héritées par défaut par les Deals rattachés.
  segment          CommercialSegment
  paymentTermsDays Int?              @map("payment_terms_days") @db.SmallInt
  currencyCode     String            @map("currency_code") @db.Char(3)
  currency         Currency          @relation("ContractCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)

  /// Engagement de volume sur la durée du contrat, à titre indicatif.
  committedVolume Decimal?       @map("committed_volume") @db.Decimal(18, 6)
  volumeUom       UnitOfMeasure? @map("volume_uom")

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  notes     String?  @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  deals Deal[]

  @@index([clientId, status])
  @@index([status, endDate])
  @@map("contracts")
}

/// Dossier d'affaire — niveau COMMERCIAL ET FINANCIER.
///
/// Porte la relation client, la structure de prix, le verrou de crédit, le
/// verrou de marge et la facturation. C'est ici, et nulle part ailleurs, que
/// se décide si l'exécution peut commencer.
model Deal {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique @db.VarChar(24) // DEAL-2026-08-001

  contractId String?   @map("contract_id") @db.Uuid
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  clientId String  @map("client_id") @db.Uuid
  client   Partner @relation("DealClient", fields: [clientId], references: [id], onDelete: Restrict)

  /// LIEU de livraison, directement — jamais via un rattachement client.
  ///
  /// ⚠️ POINTAIT AUPARAVANT VERS `PartnerSite`, UNE TABLE SANS AUCUNE
  ///    INTERFACE DE CRÉATION DANS L'APPLICATION QUI TOURNE.
  ///
  ///    Un site créé au référentiel autonome des sites n'apparaissait donc
  ///    JAMAIS dans le choix du lieu de livraison d'une affaire, pour aucun
  ///    client — le formulaire ne lisait que les rattachements déjà en base
  ///    (semis initial), qu'aucun écran ne permettait de compléter. Le seul
  ///    repli était un champ libre, sans consigne HSE rattachée. Constaté en
  ///    direct : la base de staging ne comptait ni pool ni rattachement,
  ///    l'écran de création d'affaire était donc inutilisable pour tout site
  ///    réel.
  ///
  ///    `CarrierTariff` référence déjà `Site` directement des deux côtés
  ///    (origine et destination) — c'est le motif que ce champ suit
  ///    maintenant, au lieu de rester l'exception. La désignation « telle que
  ///    le client la reconnaît », raison d'être invoquée de `PartnerSite`,
  ///    n'était de toute façon lue nulle part : ni le gabarit de bon de
  ///    livraison ni son générateur ne consultaient ce champ.
  siteId String? @map("site_id") @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation("DealProduct", fields: [productId], references: [id], onDelete: Restrict)

  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  status  DealStatus        @default(DRAFT)
  segment CommercialSegment

  // --- Objet commercial ---
  //
  // `contractedVolume`/`uom` restent NOT NULL : un produit SERVICE (barge)
  // vaut 1/FORFAIT par convention plutôt que NULL, pour que la chaîne de
  // marge (exprimée « par unité » partout ailleurs) reste valable sans cas
  // particulier — voir `UnitOfMeasure.FORFAIT`.
  contractedVolume Decimal       @map("contracted_volume") @db.Decimal(18, 6)
  uom              UnitOfMeasure
  incoterm         String?       @db.VarChar(8)
  /// NULLE pour un produit SERVICE : rien n'y est physiquement transporté.
  transportMode      TransportMode? @map("transport_mode")
  deliveryLocation   String         @map("delivery_location") @db.VarChar(200)
  targetDeliveryDate DateTime?      @map("target_delivery_date") @db.Date

  // --- Devises (§ 9.2) : transaction, pivot, document ---
  currencyCode String   @map("currency_code") @db.Char(3)
  currency     Currency @relation("DealCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  /// Taux vers la devise pivot, FIGÉ à l'approbation — le risque crédit doit
  /// rester comparable dans le temps.
  fxRateToPivot Decimal   @default(1) @map("fx_rate_to_pivot") @db.Decimal(18, 8)
  fxRateId      String?   @map("fx_rate_id") @db.Uuid
  fxRate        FxRate?   @relation("DealFxRate", fields: [fxRateId], references: [id], onDelete: Restrict)
  fxRateDate    DateTime? @map("fx_rate_date") @db.Date

  // --- Structure de prix PRÉVISIONNELLE, en devise de transaction (§ 5).
  //
  //     Ces montants servent à approuver la marge AVANT toute exécution. Ils
  //     ne pilotent pas la facturation : volume et prix sont saisis à
  //     l'édition de chaque pièce et peuvent différer (§ 9.1).
  //
  //     Le prix d'achat réel figure sur la commande d'achat ; l'écart entre
  //     prévisionnel et réel est une information de gestion, pas une anomalie.
  unitSalePrice Decimal @default(0) @map("unit_sale_price") @db.Decimal(18, 4)
  saleAmount    Decimal @default(0) @map("sale_amount") @db.Decimal(18, 4)

  /// Le prix d'achat n'est JAMAIS libre : il provient d'un prix fournisseur
  /// validé par le DG. C'est le levier le plus simple pour gonfler un coût et
  /// détourner la différence — le fermer est le contrôle anti-fraude principal.
  supplierPriceId   String?        @map("supplier_price_id") @db.Uuid
  supplierPrice     SupplierPrice? @relation("DealSupplierPrice", fields: [supplierPriceId], references: [id], onDelete: Restrict)
  unitPurchasePrice Decimal        @default(0) @map("unit_purchase_price") @db.Decimal(18, 4)
  purchaseAmount    Decimal        @default(0) @map("purchase_amount") @db.Decimal(18, 4)

  /// Réduction commerciale prévue. Elle diminue le montant de vente, donc la
  /// marge : le prévisionnel doit en tenir compte pour que le seuil ait un sens.
  discountMode   DiscountMode? @map("discount_mode")
  discountValue  Decimal?      @map("discount_value") @db.Decimal(18, 4)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(18, 4)

  /// Prix administré consulté au moment de fixer le prix — référence, jamais
  /// dérivation (§ 5.3).
  referencePriceId String?            @map("reference_price_id") @db.Uuid
  referencePrice   AdministeredPrice? @relation(fields: [referencePriceId], references: [id], onDelete: SetNull)
  pricingNotes     String?            @map("pricing_notes") @db.VarChar(1000)

  /// Charges prévisionnelles agrégées, ventilées par poste dans OperationCostLine.
  estimatedDirectCharges   Decimal @default(0) @map("estimated_direct_charges") @db.Decimal(18, 4)
  estimatedIndirectCharges Decimal @default(0) @map("estimated_indirect_charges") @db.Decimal(18, 4)
  /// Coût de portage financier — calculé, jamais saisi (§ 5.4).
  estimatedCarryingCost Decimal @default(0) @map("estimated_carrying_cost") @db.Decimal(18, 4)

  // --- Marges (§ 5.4). Unitaires, dans l'unité du Deal. ---
  /// Vente − achat − charges directes − portage. Sous le plancher : BLOCAGE DUR.
  estimatedDirectMargin Decimal @default(0) @map("estimated_direct_margin") @db.Decimal(18, 4)
  /// Après absorption des indirectes. Sous le seuil : accord DG obligatoire.
  estimatedFullMargin Decimal @default(0) @map("estimated_full_margin") @db.Decimal(18, 4)
  /// Marges réelles, calculées à la clôture sur les coûts constatés.
  realizedDirectMargin Decimal? @map("realized_direct_margin") @db.Decimal(18, 4)
  realizedFullMargin   Decimal? @map("realized_full_margin") @db.Decimal(18, 4)

  /// Montant de vente en devise pivot — base de l'agrégation du risque.
  saleAmountPivot Decimal @default(0) @map("sale_amount_pivot") @db.Decimal(18, 4)

  // --- VERROU FINANCIER (§ 7.1, § 11.2) ---
  /// Renseigné EXCLUSIVEMENT par FINANCE_CFO (ou DG en dérogation). Sa présence
  /// est la condition, vérifiée en base, de l'existence de toute Opération.
  creditApprovedById String?   @map("credit_approved_by_id") @db.Uuid
  creditApprovedBy   User?     @relation("DealCreditApprover", fields: [creditApprovedById], references: [id], onDelete: Restrict)
  creditApprovedAt   DateTime? @map("credit_approved_at") @db.Timestamptz(3)
  /// En-cours du client au moment de l'approbation — figé pour la traçabilité.
  creditExposureAtApproval Decimal? @map("credit_exposure_at_approval") @db.Decimal(18, 4)

  // --- Dérogation DG sur marge (§ 5.4) ---
  dgApprovedById     String?     @map("dg_approved_by_id") @db.Uuid
  dgApprovedBy       User?       @relation("DealDgApprover", fields: [dgApprovedById], references: [id], onDelete: Restrict)
  dgApprovedAt       DateTime?   @map("dg_approved_at") @db.Timestamptz(3)
  marginDerogationId String?     @unique @map("margin_derogation_id") @db.Uuid
  marginDerogation   Derogation? @relation("DealMarginDerogation", fields: [marginDerogationId], references: [id], onDelete: SetNull)

  /// Motif de l'écart entre le prix retenu et le prix fournisseur validé.
  /// Le prix d'achat reste ADOSSÉ à une ligne validée par le DG ; il peut s'en
  /// écarter dans une bande paramétrable, au-delà de laquelle l'affaire ne
  /// peut être approuvée sans dérogation du DG (§ 5.4).
  purchasePriceVarianceReason String?     @map("purchase_price_variance_reason") @db.VarChar(500)
  purchasePriceDerogationId   String?     @unique @map("purchase_price_derogation_id") @db.Uuid
  purchasePriceDerogation     Derogation? @relation("DealPurchasePriceDerogation", fields: [purchasePriceDerogationId], references: [id], onDelete: SetNull)

  /// Dérogation du DG autorisant l'approbation AU-DELÀ du plafond de crédit du
  /// client (§ 9.1). Soumise aux mêmes conditions d'opposabilité que les
  /// autres : révoquée, échue ou accordée pour une autre affaire, elle n'ouvre
  /// rien.
  creditDerogationId String?     @unique @map("credit_derogation_id") @db.Uuid
  creditDerogation   Derogation? @relation("DealCreditDerogation", fields: [creditDerogationId], references: [id], onDelete: SetNull)

  // --- Acceptation client ---
  acceptedByPortalUserId String?     @map("accepted_by_portal_user_id") @db.Uuid
  acceptedByPortalUser   PortalUser? @relation("DealAcceptedBy", fields: [acceptedByPortalUserId], references: [id], onDelete: SetNull)
  acceptedAt             DateTime?   @map("accepted_at") @db.Timestamptz(3)

  // --- Régime documentaire (§ 9.4), hérité du client et surchargeable ---
  documentaryRegime DocumentaryRegime @default(PROFORMA_THEN_FNE) @map("documentary_regime")
  /// Motif obligatoire dès que le moteur écarte la FNE — opposable en contrôle.
  fneExclusionReason String? @map("fne_exclusion_reason") @db.VarChar(1000)

  cancellationReason String?   @map("cancellation_reason") @db.VarChar(1000)
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  costLines          DealCostLine[]
  operations         Operation[]
  invoices           Invoice[]
  supplierInvoices   SupplierInvoice[] @relation("DealSupplierInvoices")
  guarantees         Guarantee[]
  statusTransitions  DealStatusTransition[]
  generatedDocuments GeneratedDocument[]

  @@index([status, createdAt])
  @@index([clientId, status])
  @@index([ownerId, status])
  @@index([segment, status])
  @@index([contractId])
  @@map("deals")

  crmOpportunity CrmOpportunity?
  quotationRequest QuotationRequest?
}

/// Journal des transitions du Deal. Append-only : c'est la preuve du
/// franchissement du verrou financier.
model DealStatusTransition {
  id     String @id @default(uuid()) @db.Uuid
  dealId String @map("deal_id") @db.Uuid
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  fromStatus DealStatus? @map("from_status")
  toStatus   DealStatus  @map("to_status")

  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id") @db.Uuid
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  reason    String?   @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([dealId, createdAt])
  @@index([toStatus, createdAt])
  @@map("deal_status_transitions")
}

// ============================================================================
//  OPÉRATION — NIVEAU EXÉCUTION PHYSIQUE
//  Réf. SPECIFICATIONS.md § 4.3
//
//  Un Deal engendre une ou plusieurs Opérations : un contrat minier livré en
//  douze rotations, c'est 1 Deal et 12 Opérations. C'est aussi le seul objet
//  que voit l'application terrain — le Deal, ses prix et ses marges n'existent
//  pas dans ce périmètre.
// ============================================================================

model Operation {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique @db.VarChar(24) // OP-2026-000154

  dealId String @map("deal_id") @db.Uuid
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Restrict)

  status       OperationStatus @default(DRAFT)
  sourcingMode SourcingMode    @default(BACK_TO_BACK) @map("sourcing_mode")

  /// TYPES portés par l'opération, indiqués à sa création. Ils déterminent les
  /// contrôles HSE à lui adjoindre — union des checklists de chaque type.
  operationTypes OperationTypeAssignment[]
  /// Journal des événements produits sur la tablette pour cette opération.
  syncEvents FieldSyncEvent[]
  /// Exigences du site de livraison levées pour cette opération.
  siteRequirementAcks OperationSiteRequirementAck[]

  /// Propriétaire du produit transporté. Renseigné en THIRD_PARTY_PRODUCT :
  /// la marchandise de tiers n'est JAMAIS valorisée au stock Elyon.
  productOwnerId String?  @map("product_owner_id") @db.Uuid
  productOwner   Partner? @relation("OperationProductOwner", fields: [productOwnerId], references: [id], onDelete: SetNull)

  // --- Objet physique ---
  plannedVolume Decimal       @map("planned_volume") @db.Decimal(18, 6)
  uom           UnitOfMeasure
  transportMode TransportMode @map("transport_mode")

  originLocation String  @map("origin_location") @db.VarChar(200)
  /// SITE DE CHARGEMENT — le lieu d'où part le produit (§ 6.2).
  originSiteId   String? @map("origin_site_id") @db.Uuid
  originSite     Site?   @relation("OperationOrigin", fields: [originSiteId], references: [id], onDelete: SetNull)

  /// SITE DE LIVRAISON — hérité du `siteId` de l'affaire (§ 6.2), jamais
  /// choisi indépendamment par l'appelant : une opération qui s'écarterait
  /// du lieu contracté serait une erreur, pas un choix (voir `create()` dans
  /// `operations.controller.ts`).
  ///
  /// ⚠️ POINTAIT AUPARAVANT VERS `PartnerSite` — une asymétrie avec l'origine
  ///    ci-dessus qui se voulait délibérée (« le bon de livraison doit porter
  ///    la désignation que le client reconnaît ») mais dont la fonctionnalité
  ///    n'était : ni créable (aucun écran ne permettait d'ajouter un
  ///    rattachement client-site), ni même lue par le générateur de bon de
  ///    livraison. Symétrique avec l'origine désormais, comme le fait déjà
  ///    `CarrierTariff` des deux côtés de son propre trajet.
  destinationSiteId   String? @map("destination_site_id") @db.Uuid
  destinationSite     Site?   @relation("OperationDestination", fields: [destinationSiteId], references: [id], onDelete: SetNull)
  destinationLocation String  @map("destination_location") @db.VarChar(200)

  plannedLoadingDate  DateTime? @map("planned_loading_date") @db.Date
  actualLoadingDate   DateTime? @map("actual_loading_date") @db.Date
  actualDischargeDate DateTime? @map("actual_discharge_date") @db.Date
  /// Date de connaissement — pivot des conventions AROUND_BL_DATE (§ 5.6).
  billOfLadingDate DateTime? @map("bill_of_lading_date") @db.Date

  // --- VERROU HSE (§ 7.2, § 11.2) ---
  /// Détermine la checklist applicable et l'exigence de présence du contrôleur.
  hseRiskLevel HseRiskLevel @default(STANDARD) @map("hse_risk_level")
  /// Renseigné par le CONTRÔLEUR HSE seul. Sa présence conditionne le passage
  /// au chargement — vérifié en base.
  hseValidatedById String?    @map("hse_validated_by_id") @db.Uuid
  hseValidatedBy   FieldUser? @relation("OperationHseValidator", fields: [hseValidatedById], references: [id], onDelete: Restrict)
  hseValidatedAt   DateTime?  @map("hse_validated_at") @db.Timestamptz(3)
  /// Suppléance éventuelle : le DG valide en l'absence du contrôleur (§ 3.4).
  hseValidatedByUserId String? @map("hse_validated_by_user_id") @db.Uuid
  hseValidatedByUser   User?   @relation("OperationHseValidatorUser", fields: [hseValidatedByUserId], references: [id], onDelete: Restrict)
  hseDerogationId      String? @unique @map("hse_derogation_id") @db.Uuid
  hseDerogation        Derogation? @relation("OperationHseDerogation", fields: [hseDerogationId], references: [id], onDelete: SetNull)

  // --- Affectation terrain ---
  fieldAgentId String?    @map("field_agent_id") @db.Uuid
  fieldAgent   FieldUser? @relation("OperationFieldAgent", fields: [fieldAgentId], references: [id], onDelete: SetNull)

  // --- Coordination ---
  coordinatorId String? @map("coordinator_id") @db.Uuid
  coordinator   User?   @relation("OperationCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)

  cancellationReason String?   @map("cancellation_reason") @db.VarChar(1000)
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchaseOrder      PurchaseOrder?
  assignment         OperationAssignment?
  hseChecks          OperationHseCheck[]
  hseEvents          HseEvent[]
  measurements       MeasurementRecord[]
  costLines          OperationCostLine[]
  statusTransitions  OperationStatusTransition[]
  generatedDocuments GeneratedDocument[]

  @@index([dealId, status])
  @@index([status, plannedLoadingDate])
  @@index([fieldAgentId, status])
  @@index([hseRiskLevel, status])
  @@map("operations")
}

model OperationStatusTransition {
  id          String    @id @default(uuid()) @db.Uuid
  operationId String    @map("operation_id") @db.Uuid
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  fromStatus OperationStatus? @map("from_status")
  toStatus   OperationStatus  @map("to_status")

  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id") @db.Uuid
  reason    String?   @db.VarChar(1000)

  /// Horodatage de l'appareil, distinct de celui du serveur : l'horloge d'une
  /// tablette n'est pas fiable, et l'écart est en soi un signal d'audit (§ 10.2).
  deviceTimestamp DateTime? @map("device_timestamp") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([operationId, createdAt])
  @@map("operation_status_transitions")
}

/// Moyens affectés à une opération — porte le VERROU DE CONFORMITÉ (§ 11.2).
///
/// Un sous-traitant, véhicule ou chauffeur non conforme ne peut être affecté
/// sans dérogation du DG. Le contrôle est fait en base au moment de l'écriture :
/// le statut de conformité, lui, est dérivé des pièces à échéance (lot 1).
model OperationAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  operationId String    @unique @map("operation_id") @db.Uuid
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  carrierId String?  @map("carrier_id") @db.Uuid
  carrier   Partner? @relation("AssignmentCarrier", fields: [carrierId], references: [id], onDelete: Restrict)
  vehicleId String?  @map("vehicle_id") @db.Uuid
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driverId  String?  @map("driver_id") @db.Uuid
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: Restrict)

  /// Nom du navire, de la barge ou identifiant de ligne pipeline selon le mode.
  vehicleIdentifier String? @map("vehicle_identifier") @db.VarChar(120)

  freightCost   Decimal   @default(0) @map("freight_cost") @db.Decimal(18, 4)

  /// Tarif du transporteur ayant servi de référence, et écart assumé.
  ///
  /// Le montant reste saisissable — un déplacement exceptionnel, une attente
  /// facturée, une négociation ponctuelle existent — mais l'écart au tarif
  /// négocié doit être MOTIVÉ. C'est la même règle que le barème de coûts, et
  /// elle est tenue en base.
  carrierTariffId String? @map("carrier_tariff_id") @db.Uuid
  /// Montant qu'aurait donné le tarif, FIGÉ au moment de l'affectation : un
  /// tarif révisé ensuite ne doit pas requalifier un écart déjà motivé.
  tariffAmount    Decimal? @map("tariff_amount") @db.Decimal(18, 4)
  tariffTolerancePct Decimal? @map("tariff_tolerance_pct") @db.Decimal(6, 3)
  freightVarianceReason String? @map("freight_variance_reason") @db.VarChar(500)
  currencyCode  String    @map("currency_code") @db.Char(3)
  currency      Currency  @relation("AssignmentCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  fxRateToPivot Decimal   @default(1) @map("fx_rate_to_pivot") @db.Decimal(18, 8)

  /// Dérogation obligatoire si l'un des moyens est non conforme — DG seul.
  complianceDerogationId String?     @unique @map("compliance_derogation_id") @db.Uuid
  complianceDerogation   Derogation? @relation("AssignmentDerogation", fields: [complianceDerogationId], references: [id], onDelete: SetNull)

  assignedById String?   @map("assigned_by_id") @db.Uuid
  assignedBy   User?     @relation("AssignmentAuthor", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt   DateTime? @map("assigned_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([carrierId])
  @@index([vehicleId])
  @@index([driverId])
  @@map("operation_assignments")
}

/// Commande d'achat adossée. En mode BACK_TO_BACK, relation 1-to-1 STRICTE
/// avec l'opération : un achat ne sert qu'une vente. Les autres modes
/// d'approvisionnement n'en créent pas.
model PurchaseOrder {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique @db.VarChar(24)

  operationId String    @unique @map("operation_id") @db.Uuid
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  supplierId String  @map("supplier_id") @db.Uuid
  supplier   Partner @relation("PoSupplier", fields: [supplierId], references: [id], onDelete: Restrict)

  status PurchaseOrderStatus @default(DRAFT)

  orderedVolume Decimal       @map("ordered_volume") @db.Decimal(18, 6)
  uom           UnitOfMeasure
  unitPrice     Decimal       @map("unit_price") @db.Decimal(18, 4)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(18, 4)

  currencyCode  String   @map("currency_code") @db.Char(3)
  currency      Currency @relation("PoCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  fxRateToPivot Decimal  @default(1) @map("fx_rate_to_pivot") @db.Decimal(18, 8)


  /// Prix fournisseur ayant servi de base — traçabilité du coût d'achat.
  supplierPriceId String?        @map("supplier_price_id") @db.Uuid
  supplierPrice   SupplierPrice? @relation(fields: [supplierPriceId], references: [id], onDelete: SetNull)

  loadingPort  String?   @map("loading_port") @db.VarChar(200)
  expectedDate DateTime? @map("expected_date") @db.Date

  issuedById String?   @map("issued_by_id") @db.Uuid
  issuedBy   User?     @relation("PoIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt   DateTime? @map("issued_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplierInvoices SupplierInvoice[]

  @@index([supplierId, status])
  @@index([status, expectedDate])
  @@map("purchase_orders")
}

// ============================================================================
//  HSE D'EXÉCUTION
//  Réf. SPECIFICATIONS.md § 7
//
//  Le HSE est intégré au workflow, pas annexe. Les contrôles bloquants
//  empêchent la poursuite de l'opération — et l'agent qui exécute ne peut
//  jamais valider sa propre conformité (§ 3.2, invariant 4).
// ============================================================================

/// Instance de checklist appliquée à une opération.
model OperationHseCheck {
  id          String    @id @default(uuid()) @db.Uuid
  operationId String    @map("operation_id") @db.Uuid
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  /// Modèle dominant, à titre indicatif seulement.
  ///
  /// Une opération porte PLUSIEURS types — route puis soutage — et sa
  /// checklist est l'union de leurs modèles. Il n'y a donc plus de modèle
  /// unique à désigner ici : la provenance exacte, avec sa version, est portée
  /// point par point (OperationHseCheckItem.sourceTemplateId). Nul ne doit
  /// s'appuyer sur ce champ pour établir ce qui a été contrôlé.
  templateId String?              @map("template_id") @db.Uuid
  template   HseChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion Int? @map("template_version") @db.SmallInt

  phase OperationPhase

  /// Renseigné par le CONTRÔLEUR HSE, ou par le DG en suppléance (§ 3.4).
  validatedByFieldUserId String?    @map("validated_by_field_user_id") @db.Uuid
  validatedByFieldUser   FieldUser? @relation("HseCheckValidator", fields: [validatedByFieldUserId], references: [id], onDelete: Restrict)
  validatedByUserId      String?    @map("validated_by_user_id") @db.Uuid
  validatedByUser        User?      @relation("HseCheckValidatorUser", fields: [validatedByUserId], references: [id], onDelete: Restrict)
  validatedAt            DateTime?  @map("validated_at") @db.Timestamptz(3)

  /// Validation à distance sur photos et relevés — mode normal, l'entreprise
  /// ne comptant qu'un contrôleur HSE (§ 7.2).
  validatedRemotely Boolean @default(false) @map("validated_remotely")

  /// Rejet par le CONTRÔLEUR HSE, ou par son suppléant — une checklist dont
  /// un point bloquant interdit de poursuivre l'opération en l'état. Distinct
  /// de la validation : `validatedAt` reste NUL tant qu'elle n'a pas été
  /// reprise et effectivement validée. Les points restent modifiables par
  /// l'agent, exactement comme avant toute validation.
  rejectedByFieldUserId String?    @map("rejected_by_field_user_id") @db.Uuid
  rejectedByFieldUser   FieldUser? @relation("HseCheckRejector", fields: [rejectedByFieldUserId], references: [id], onDelete: Restrict)
  rejectedByUserId      String?    @map("rejected_by_user_id") @db.Uuid
  rejectedByUser        User?      @relation("HseCheckRejectorUser", fields: [rejectedByUserId], references: [id], onDelete: Restrict)
  rejectedAt            DateTime?  @map("rejected_at") @db.Timestamptz(3)
  rejectionReason       String?    @map("rejection_reason") @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items OperationHseCheckItem[]

  @@unique([operationId, phase])
  @@index([operationId])
  @@map("operation_hse_checks")
}

/// Résultat d'un point de contrôle.
model OperationHseCheckItem {
  id      String            @id @default(uuid()) @db.Uuid
  checkId String            @map("check_id") @db.Uuid
  check   OperationHseCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)

  itemId String           @map("item_id") @db.Uuid
  item   HseChecklistItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// Recopié du modèle : un point rendu non bloquant plus tard ne doit pas
  /// changer rétroactivement la nature du contrôle effectué.
  ///
  /// Lorsque deux types d'opération portent le même point à des niveaux
  /// différents, c'est le PLUS CONTRAIGNANT qui est figé ici : ajouter un type
  /// au déroulé ne doit jamais affaiblir un contrôle.
  level   HseControlLevel
  outcome HseCheckOutcome @default(PENDING)

  /// Provenance FIGÉE du point : de quel modèle il vient, et dans quelle
  /// version. C'est ici, et non sur la checklist, que la traçabilité se joue —
  /// une checklist assemblée à partir de plusieurs types n'a pas de modèle
  /// unique dont on pourrait invoquer la version.
  sourceTemplateId      String?               @map("source_template_id") @db.Uuid
  sourceTemplate        HseChecklistTemplate? @relation("CheckItemSource", fields: [sourceTemplateId], references: [id], onDelete: Restrict)
  sourceTemplateVersion Int?                  @map("source_template_version") @db.SmallInt

  /// Valeur relevée lorsque le point l'exige — volume, température, n° de scellé.
  recordedValue String? @map("recorded_value") @db.VarChar(500)
  comment       String? @db.VarChar(1000)

  /// L'agent RENSEIGNE le point ; il ne le VALIDE pas s'il est bloquant.
  recordedByFieldUserId String?    @map("recorded_by_field_user_id") @db.Uuid
  recordedByFieldUser   FieldUser? @relation("HseItemRecorder", fields: [recordedByFieldUserId], references: [id], onDelete: SetNull)
  recordedAt            DateTime?  @map("recorded_at") @db.Timestamptz(3)
  deviceTimestamp       DateTime?  @map("device_timestamp") @db.Timestamptz(3)

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  attachments OperationAttachment[]

  @@unique([checkId, itemId])
  @@index([checkId, outcome])
  @@map("operation_hse_check_items")
}

/// Incident, accident, déversement, quasi-accident, non-conformité.
///
/// Un écart de volume au-delà du seuil critique en ouvre un d'office (§ 8.3) :
/// le produit est allé quelque part — fuite, déversement ou détournement.
model HseEvent {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique @db.VarChar(24)

  operationId String?    @map("operation_id") @db.Uuid
  operation   Operation? @relation(fields: [operationId], references: [id], onDelete: SetNull)

  type     HseEventType
  severity HseSeverity
  status   HseEventStatus @default(OPEN)

  title       String @db.VarChar(200)
  description String @db.VarChar(4000)

  occurredAt DateTime  @map("occurred_at") @db.Timestamptz(3)
  location   String?   @db.VarChar(200)
  latitude   Decimal?  @db.Decimal(10, 7)
  longitude  Decimal?  @db.Decimal(10, 7)

  /// Vrai lorsque l'événement a été ouvert automatiquement par le système —
  /// franchissement du seuil critique d'écart de volume, typiquement.
  autoOpened Boolean @default(false) @map("auto_opened")

  declaredByFieldUserId String?    @map("declared_by_field_user_id") @db.Uuid
  declaredByFieldUser   FieldUser? @relation("HseEventDeclarer", fields: [declaredByFieldUserId], references: [id], onDelete: SetNull)
  declaredByUserId      String?    @map("declared_by_user_id") @db.Uuid
  declaredByUser        User?      @relation("HseEventDeclarerUser", fields: [declaredByUserId], references: [id], onDelete: SetNull)

  /// Clôture : exige une preuve, pas une simple case cochée (§ 7.3).
  closedById       String?   @map("closed_by_id") @db.Uuid
  closedBy         User?     @relation("HseEventCloser", fields: [closedById], references: [id], onDelete: Restrict)
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(3)
  closureEvidence  String?   @map("closure_evidence") @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actions     HseCorrectiveAction[]
  attachments OperationAttachment[]

  @@index([status, severity])
  @@index([operationId])
  @@index([type, occurredAt])
  @@map("hse_events")
}

/// Action corrective ou préventive, avec responsable et échéance.
model HseCorrectiveAction {
  id      String   @id @default(uuid()) @db.Uuid
  eventId String   @map("event_id") @db.Uuid
  event   HseEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  description String @db.VarChar(2000)
  isPreventive Boolean @default(false) @map("is_preventive")

  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation("ActionOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  dueDate     DateTime  @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  evidence    String?   @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([eventId])
  @@index([dueDate, completedAt])
  @@map("hse_corrective_actions")
}

/// Pièce jointe produite sur le terrain — photo, signature capturée, document.
///
/// Le binaire n'est jamais en base : clé de stockage objet et empreinte
/// SHA-256. Les photos transitent hors du flux d'événements (§ 10.2), sans
/// quoi une opération à vingt photos bloquerait toute la synchronisation.
model OperationAttachment {
  id String @id @default(uuid()) @db.Uuid

  /// UUID généré sur l'appareil — rend la synchronisation idempotente.
  clientUuid String @unique @map("client_uuid") @db.Uuid

  /// NATURE de la pièce.
  ///
  /// ⚠️ Sans elle, « photo exigée » et « signature exigée » se satisfaisaient
  ///    de la même chose : n'importe quelle pièce jointe. Or un point qui
  ///    demande la signature du client au bon de livraison n'est pas satisfait
  ///    par une photo du camion — et c'est précisément ce point-là qu'on
  ///    produira après un litige de livraison.
  kind AttachmentKind @default(PHOTO)

  checkItemId String?                @map("check_item_id") @db.Uuid
  checkItem   OperationHseCheckItem? @relation(fields: [checkItemId], references: [id], onDelete: Cascade)
  hseEventId  String?                @map("hse_event_id") @db.Uuid
  hseEvent    HseEvent?              @relation(fields: [hseEventId], references: [id], onDelete: Cascade)

  /// Clé dérivée de l'EMPREINTE du contenu, donc PARTAGÉE par des pièces
  /// identiques — elle n'est volontairement pas unique.
  ///
  /// Elle l'a été, et c'était une erreur : le même cliché versé à deux points
  /// de contrôle est un cas normal — un extincteur photographié une fois vaut
  /// pour le point « extincteurs » et pour le point « conformité du
  /// véhicule ». L'unicité refusait le second rattachement au motif que le
  /// fichier existait déjà, ce qui est précisément l'économie recherchée.
  ///
  /// L'unicité qui compte est ailleurs : `clientUuid`, produit par l'appareil.
  /// C'est lui qui empêche qu'une reprise après coupure dépose deux fois la
  /// même pièce.
  storageKey String @map("storage_key") @db.VarChar(512)
  mimeType   String @map("mime_type") @db.VarChar(120)
  sizeBytes  BigInt @map("size_bytes")
  sha256     String @db.Char(64)

  caption         String?   @db.VarChar(500)
  capturedAt      DateTime? @map("captured_at") @db.Timestamptz(3)
  deviceTimestamp DateTime? @map("device_timestamp") @db.Timestamptz(3)
  latitude        Decimal?  @db.Decimal(10, 7)
  longitude       Decimal?  @db.Decimal(10, 7)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([checkItemId])
  @@index([hseEventId])
  @@map("operation_attachments")
}

// ============================================================================
//  RELEVÉS DE MESURE
//  Réf. SPECIFICATIONS.md § 8
//
//  Un objet unique porte les deux natures de relevé, qui n'ont pas la même
//  valeur probante : l'inspection indépendante d'un tiers assermenté, et le
//  relevé contradictoire entre Elyon et le client. La facture définitive
//  s'appuie sur celui qui FAIT AUTORITÉ pour le segment.
// ============================================================================

model MeasurementRecord {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique @db.VarChar(24)

  operationId String    @map("operation_id") @db.Uuid
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  source MeasurementSource
  /// Vrai pour le relevé qui fait foi sur cette opération. Un seul par
  /// opération — index unique partiel en base.
  isAuthoritative Boolean @default(false) @map("is_authoritative")

  /// Inspecteur tiers, lorsque la source est une inspection indépendante.
  inspectorId String?  @map("inspector_id") @db.Uuid
  inspector   Partner? @relation("MeasurementInspector", fields: [inspectorId], references: [id], onDelete: Restrict)

  measurementDate DateTime @map("measurement_date") @db.Date

  // --- Volumes corrigés à 15 °C (ASTM D1250) ---
  //
  // ⚠️ CES DEUX COLONNES SONT DES RÉSULTATS, PAS DES SAISIES.
  //
  //    Elles étaient prises telles quelles de la tablette, sans qu'aucune
  //    correction de température n'existe nulle part dans le code. Un
  //    chargement à 32 °C et une livraison à 26 °C, saisis dans des champs
  //    nommés « à 15 °C », produisaient ~0,48 % d'écart apparent — plus du
  //    DOUBLE du seuil critique — sur une opération parfaitement saine. Et
  //    symétriquement, une perte réelle pouvait être masquée par un écart
  //    thermique inverse.
  //
  //    Elles sont désormais CALCULÉES à partir du volume observé, de la
  //    température et de la masse volumique, par le service de correction.
  loadedVolume15     Decimal       @map("loaded_volume_15") @db.Decimal(18, 6)
  dischargedVolume15 Decimal       @map("discharged_volume_15") @db.Decimal(18, 6)

  // --- Ce qui a été RÉELLEMENT relevé, aux deux bouts -----------------------
  //
  // Le § 8.2 l'exige : « l'application terrain doit OBLIGER à saisir la
  // température à chaque relevé ». Un volume sans sa température n'est pas
  // corrigible, donc pas comparable à l'autre bout.
  loadedObservedVolume     Decimal? @map("loaded_observed_volume") @db.Decimal(18, 6)
  loadedTempC              Decimal? @map("loaded_temp_c") @db.Decimal(6, 2)
  /// Facteur de correction appliqué au chargement, CONSERVÉ.
  /// Sans lui, le calcul n'est pas rejouable : une révision de la table de
  /// correction changerait rétroactivement un écart déjà acquitté.
  loadedVcf                Decimal? @map("loaded_vcf") @db.Decimal(9, 6)

  dischargedObservedVolume Decimal? @map("discharged_observed_volume") @db.Decimal(18, 6)
  dischargedTempC          Decimal? @map("discharged_temp_c") @db.Decimal(6, 2)
  dischargedVcf            Decimal? @map("discharged_vcf") @db.Decimal(9, 6)
  uom                UnitOfMeasure

  /// Volume observé et température : sans eux, la correction n'est pas
  /// vérifiable et l'écart peut être un ullage fantôme (§ 8.2).
  observedVolume Decimal? @map("observed_volume") @db.Decimal(18, 6)
  observedTempC  Decimal? @map("observed_temp_c") @db.Decimal(6, 2)

  // --- Qualité ---
  measuredDensity15   Decimal  @map("measured_density_15") @db.Decimal(9, 6)
  viscosityCst        Decimal? @map("viscosity_cst") @db.Decimal(9, 3)
  sulphurPct          Decimal? @map("sulphur_pct") @db.Decimal(6, 4)
  waterAndSedimentPct Decimal? @map("water_and_sediment_pct") @db.Decimal(6, 4)
  flashPointC         Decimal? @map("flash_point_c") @db.Decimal(6, 2)
  isOffSpec           Boolean  @default(false) @map("is_off_spec")

  // --- Écart de volume (§ 8.2, § 8.3) ---
  /// (chargé − livré) / chargé × 100. Cohérence vérifiée par CHECK.
  ullageVariancePct Decimal @map("ullage_variance_pct") @db.Decimal(9, 6)
  /// Tolérance appliquée, figée au moment du relevé : une grille révisée
  /// ensuite ne doit pas requalifier rétroactivement un écart acquitté.
  toleranceId       String?          @map("tolerance_id") @db.Uuid
  tolerance         UllageTolerance? @relation(fields: [toleranceId], references: [id], onDelete: SetNull)
  alertThresholdPct Decimal?         @map("alert_threshold_pct") @db.Decimal(9, 6)
  criticalThresholdPct Decimal?      @map("critical_threshold_pct") @db.Decimal(9, 6)

  ullageAlertTriggered    Boolean @default(false) @map("ullage_alert_triggered")
  ullageCriticalTriggered Boolean @default(false) @map("ullage_critical_triggered")

  /// Acquittement — CCOO, CFO ou DG seuls (§ 8.3). Sans lui, la facturation
  /// définitive est bloquée.
  ullageAckById   String?     @map("ullage_ack_by_id") @db.Uuid
  ullageAckBy     User?       @relation("UllageAcknowledger", fields: [ullageAckById], references: [id], onDelete: Restrict)
  ullageAckAt     DateTime?   @map("ullage_ack_at") @db.Timestamptz(3)
  ullageAckReason String?     @map("ullage_ack_reason") @db.VarChar(1000)
  ullageDerogationId String?  @unique @map("ullage_derogation_id") @db.Uuid
  ullageDerogation Derogation? @relation("UllageDerogation", fields: [ullageDerogationId], references: [id], onDelete: SetNull)

  /// Non-conformité HSE ouverte d'office au franchissement du seuil critique.
  hseEventId String? @map("hse_event_id") @db.Uuid

  enteredByFieldUserId String?    @map("entered_by_field_user_id") @db.Uuid
  enteredByFieldUser   FieldUser? @relation("MeasurementRecorder", fields: [enteredByFieldUserId], references: [id], onDelete: SetNull)
  enteredByUserId      String?    @map("entered_by_user_id") @db.Uuid
  enteredByUser        User?      @relation("MeasurementRecorderUser", fields: [enteredByUserId], references: [id], onDelete: SetNull)

  /// Un relevé non validé ne peut pas asseoir une facture définitive.
  validatedAt DateTime? @map("validated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([operationId, measurementDate])
  @@index([ullageAlertTriggered, ullageAckAt])
  @@index([source, isAuthoritative])
  @@map("measurement_records")
}

// ============================================================================
//  COÛTS D'OPÉRATION
//  Réf. SPECIFICATIONS.md § 5.4, § 6.5
//
//  Chaque ligne porte un montant PRÉVISIONNEL et un montant RÉEL : le premier
//  alimente le contrôle de marge à l'approbation, le second celui de la clôture.
// ============================================================================

/// BARÈME DE COÛTS STANDARDS — la valeur pré-paramétrée d'un poste (§ 5.4).
///
/// Sans valeur de référence, il n'y a rien dont s'écarter : un transport
/// chiffré à 45 FCFA/L au lieu de 30 ne se voit pas. C'est l'écart au barème
/// qui porte le signal, pas le montant lui-même.
///
/// La résolution va du plus spécifique au plus général — produit, puis mode de
/// transport, puis segment — de sorte qu'un barème général serve de filet sans
/// empêcher une ligne dédiée.
/// TARIF DE TRANSPORT — le barème d'un TRANSPORTEUR, administrable.
///
/// Décision de la direction, 7 août 2026 :
///
///   « Assure-toi que le coût du transport est administrable et lié à un
///     transporteur enregistré. »
///
/// ⚠️ LE FRET SE SAISISSAIT LIBREMENT, SANS TARIF ET SANS TRANSPORTEUR.
///
///    `OperationAssignment.freightCost` était un nombre libre, et
///    `carrierId` était facultatif : on pouvait engager un coût de transport
///    sans contrepartie identifiée. Personne ne pouvait dire, à la lecture,
///    si le montant retenu correspondait à ce qui avait été négocié — ni même
///    avec qui.
///
///    C'est le poste de charge le plus lourd d'une opération de distribution.
///    Un franc d'écart porté sur dix millions de litres crée un préjudice.
///
/// Le tarif se résout du PLUS SPÉCIFIQUE au plus général, comme le barème de
/// coûts : un tarif posé pour un site de livraison précis l'emporte sur le
/// tarif général du transporteur.
model CarrierTariff {
  id String @id @default(uuid()) @db.Uuid

  /// Le TRANSPORTEUR. Obligatoire : un tarif sans transporteur ne se négocie
  /// avec personne.
  carrierId String  @map("carrier_id") @db.Uuid
  carrier   Partner @relation("CarrierTariffPartner", fields: [carrierId], references: [id], onDelete: Cascade)

  /// Contexte d'application. Vide = s'applique à tout ce que ce transporteur
  /// exécute.
  transportMode TransportMode? @map("transport_mode")
  productId     String?        @map("product_id") @db.Uuid
  product       Product?       @relation("CarrierTariffProduct", fields: [productId], references: [id], onDelete: Cascade)
  /// LE TRAJET — origine et destination, deux LIEUX (§ 6.2).
  ///
  /// Un tarif se négocie pour un TRAJET, pas pour un client : « Abidjan → Man »
  /// et « San Pédro → Man » n'ont pas le même prix, et plusieurs clients se
  /// font livrer au même endroit.
  originSiteId String? @map("origin_site_id") @db.Uuid
  originSite   Site?   @relation("CarrierTariffOrigin", fields: [originSiteId], references: [id], onDelete: Cascade)
  destinationSiteId String? @map("destination_site_id") @db.Uuid
  destinationSite   Site?   @relation("CarrierTariffDestination", fields: [destinationSiteId], references: [id], onDelete: Cascade)

  /// PER_UNIT : au litre transporté. FIXED : forfait par rotation.
  basis  CostBasis
  amount Decimal   @db.Decimal(18, 4)

  currencyCode String   @map("currency_code") @db.Char(3)
  currency     Currency @relation("CarrierTariffCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  uom          UnitOfMeasure?

  /// Écart toléré avant qu'un motif écrit soit exigé, en %.
  /// Vide ou zéro : TOUT écart doit être motivé — c'est la règle stricte
  /// retenue pour le barème de coûts, et elle vaut ici pour la même raison.
  tolerancePct Decimal? @map("tolerance_pct") @db.Decimal(6, 3)

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  notes    String? @db.VarChar(500)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([carrierId, isActive, effectiveFrom])
  @@map("carrier_tariffs")
}

model CostStandard {
  id String @id @default(uuid()) @db.Uuid

  costPostId String   @map("cost_post_id") @db.Uuid
  costPost   CostPost @relation("CostStandardPost", fields: [costPostId], references: [id], onDelete: Cascade)

  /// Contexte d'application. Vide = s'applique à tous.
  segment       CommercialSegment?
  transportMode TransportMode?     @map("transport_mode")
  productId     String?            @map("product_id") @db.Uuid
  product       Product?           @relation("CostStandardProduct", fields: [productId], references: [id], onDelete: Cascade)

  /// PER_UNIT : montant par unité vendue. FIXED : forfait pour l'affaire.
  /// Le système ramène l'un et l'autre au litre — certains coûts sont
  /// proportionnels au volume, d'autres non, et les confondre fausse les deux.
  basis  CostBasis
  amount Decimal   @db.Decimal(18, 4)

  currencyCode String   @map("currency_code") @db.Char(3)
  currency     Currency @relation("CostStandardCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  /// Unité de référence lorsque la base est PER_UNIT.
  uom UnitOfMeasure?

  /// Écart toléré avant que le chiffrage n'exige une justification, en %.
  /// Vide : tout écart au barème doit être motivé.
  tolerancePct Decimal? @map("tolerance_pct") @db.Decimal(6, 3)

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  notes String? @db.VarChar(500)

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation("CostStandardAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([costPostId, segment, transportMode, productId, effectiveFrom])
  @@index([costPostId, effectiveFrom(sort: Desc)])
  @@map("cost_standards")
}

/// Coût CHIFFRÉ par le commercial à la construction de l'affaire (§ 5.4).
///
/// C'est ici que se joue la sincérité du devis. Sans ces lignes, la marge
/// annoncée à l'approbation ignore le transport, la manutention et
/// l'inspection : elle est surévaluée du montant exact de ce qu'on a omis, et
/// le CFO approuve sur un chiffre qui n'a jamais existé.
///
/// Ces montants sont une ESTIMATION. Dès qu'une opération enregistre ses coûts
/// constatés, ceux-ci prennent le relais — l'écart entre les deux est le
/// contrôle de fiabilité du chiffrage (§ 14.6).
model DealCostLine {
  id     String @id @default(uuid()) @db.Uuid
  dealId String @map("deal_id") @db.Uuid
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  costPostId String   @map("cost_post_id") @db.Uuid
  costPost   CostPost @relation("DealCostLinePost", fields: [costPostId], references: [id], onDelete: Restrict)

  description String? @db.VarChar(255)

  /// Fournisseur pressenti — facultatif au chiffrage, il le devient à
  /// l'exécution.
  supplierId String?  @map("supplier_id") @db.Uuid
  supplier   Partner? @relation("DealCostLineSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  /// Valeur du barème au moment du chiffrage, FIGÉE.
  /// Un barème révisé ensuite ne doit pas requalifier rétroactivement un écart
  /// qui avait été justifié et accepté.
  standardAmount Decimal? @map("standard_amount") @db.Decimal(18, 4)
  standardBasis  CostBasis? @map("standard_basis")
  /// Tolérance du barème, figée elle aussi. Zéro par défaut : toute valeur
  /// différente de celle proposée doit être justifiée.
  standardTolerancePct Decimal? @map("standard_tolerance_pct") @db.Decimal(6, 3)

  /// Base de SAISIE choisie par le commercial : il tape 30 FCFA/L, ou bien
  /// 900 000 forfaitaires. Les deux se rencontrent en pratique, et l'imposer
  /// dans un seul sens force une conversion mentale — donc une erreur.
  basis CostBasis @default(FIXED)

  /// Ce que le commercial a effectivement TAPÉ, dans la base ci-dessus.
  /// Conservé tel quel : c'est ce qu'il faut lui réafficher, pas un total
  /// recalculé qu'il ne reconnaîtrait pas.
  inputAmount Decimal @default(0) @map("input_amount") @db.Decimal(18, 4)

  /// Montant RETENU, TOTAL pour l'affaire, dans la devise de l'affaire.
  /// Dérivé : forfait tel quel, ou valeur unitaire × volume contracté.
  /// C'est lui que la chaîne de marge additionne puis ramène au litre.
  estimatedAmount Decimal @map("estimated_amount") @db.Decimal(18, 4)

  /// Obligatoire dès que l'écart au barème dépasse la tolérance. Un écart
  /// silencieux est indistinguable d'une erreur de saisie.
  varianceReason String? @map("variance_reason") @db.VarChar(500)

  currencyCode  String   @map("currency_code") @db.Char(3)
  currency      Currency @relation("DealCostLineCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  fxRateToPivot Decimal  @default(1) @map("fx_rate_to_pivot") @db.Decimal(18, 8)

  /// Ligne posée par le système — portage financier notamment. Elle n'est pas
  /// saisissable, et le commercial ne peut ni la retirer ni la minorer.
  isSystemComputed Boolean @default(false) @map("is_system_computed")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([dealId, costPostId])
  @@index([dealId])
  @@map("deal_cost_lines")
}

model OperationCostLine {
  id          String    @id @default(uuid()) @db.Uuid
  operationId String    @map("operation_id") @db.Uuid
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  costPostId String   @map("cost_post_id") @db.Uuid
  costPost   CostPost @relation(fields: [costPostId], references: [id], onDelete: Restrict)

  description String? @db.VarChar(255)

  supplierId String?  @map("supplier_id") @db.Uuid
  supplier   Partner? @relation("CostLineSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  estimatedAmount Decimal  @default(0) @map("estimated_amount") @db.Decimal(18, 4)
  actualAmount    Decimal? @map("actual_amount") @db.Decimal(18, 4)

  currencyCode  String   @map("currency_code") @db.Char(3)
  currency      Currency @relation("CostLineCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  fxRateToPivot Decimal  @default(1) @map("fx_rate_to_pivot") @db.Decimal(18, 8)
  /// Cours vers la devise de L'AFFAIRE, figé à la saisie de la ligne.
  ///
  /// ⚠️ Sans lui, les montants étaient additionnés BRUTS quelle que soit leur
  ///    devise : une inspection à 5 000 USD comptait pour 5 000 FCFA dans la
  ///    marge d'une affaire en XOF. Figé, et non relu au jour du calcul : une
  ///    marge qui bouge parce que le dollar a bougé n'est plus une marge.
  fxRateToDeal Decimal @default(1) @map("fx_rate_to_deal") @db.Decimal(18, 8)


  /// Ligne calculée par le système : portage financier, perte de volume.
  /// Non modifiable manuellement — vérifié en base.
  isSystemComputed Boolean @default(false) @map("is_system_computed")

  /// Répartition entre plusieurs clients desservis par une même opération :
  /// au prorata des volumes livrés (§ 5.4).
  allocationRatio Decimal? @map("allocation_ratio") @db.Decimal(9, 6)

  incurredAt DateTime? @map("incurred_at") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplierInvoiceId String?          @map("supplier_invoice_id") @db.Uuid
  supplierInvoice   SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id], onDelete: SetNull)

  @@index([operationId, costPostId])
  @@index([supplierId])
  @@map("operation_cost_lines")
}

// ============================================================================
//  FACTURATION
//  Réf. SPECIFICATIONS.md § 9
//
//  Quatre couches : formation du prix, devises, choix du document, cycle fiscal.
//  Trois plans monétaires par pièce — transaction, pivot, document.
// ============================================================================

model Invoice {
  id String @id @default(uuid()) @db.Uuid
  /// Numérotation légale : séquentielle, sans trou, chronologique.
  number String @unique @db.VarChar(32)

  type   InvoiceType
  status InvoiceStatus @default(DRAFT)

  /// ⚠️ OPTIONNEL DEPUIS LE 17/08 — UNE PROFORMA PEUT PRÉCÉDER TOUTE AFFAIRE.
  ///
  ///    Une proforma répondant à une demande de cotation n'a encore aucune
  ///    affaire à référencer : c'est justement ce qu'elle prépare. La
  ///    contrainte `chk_invoices_deal_or_quotation` exige l'un OU l'autre,
  ///    jamais ni l'un ni l'autre. À la conversion, la proforma approuvée
  ///    reçoit un `dealId` en plus de son `quotationRequestId` - elle ne
  ///    perd pas sa provenance en gagnant une affaire.
  dealId    String?  @map("deal_id") @db.Uuid
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Restrict)
  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation("InvoicePartner", fields: [partnerId], references: [id], onDelete: Restrict)

  /// Demande de cotation dont cette proforma est la réponse. Voir `dealId`.
  quotationRequestId String?           @map("quotation_request_id") @db.Uuid
  quotationRequest    QuotationRequest? @relation("QuotationProformas", fields: [quotationRequestId], references: [id], onDelete: Restrict)
  approvedForQuotation QuotationRequest? @relation("QuotationApprovedProforma")

  /// Approbation CLIENT depuis le portail (§ discussion 17/08) - distincte de
  /// l'émission interne : c'est le client qui accepte les termes, pas
  /// l'entreprise qui les lui impose.
  acceptedByPortalUserId String?     @map("accepted_by_portal_user_id") @db.Uuid
  acceptedByPortalUser   PortalUser? @relation("InvoiceAcceptedBy", fields: [acceptedByPortalUserId], references: [id], onDelete: SetNull)
  acceptedAt             DateTime?   @map("accepted_at") @db.Timestamptz(3)

  /// Qui a saisi la pièce — séparation des tâches (§ 1.4) : cette personne ne
  /// peut pas être celle qui en enregistre le règlement.
  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// Avoir : référence la pièce qu'il corrige.
  correctedInvoiceId String?   @map("corrected_invoice_id") @db.Uuid
  correctedInvoice   Invoice?  @relation("InvoiceCorrection", fields: [correctedInvoiceId], references: [id], onDelete: Restrict)
  creditNotes        Invoice[] @relation("InvoiceCorrection")

  /// Proforma dont la pièce est issue — traçabilité du § 12.1.
  sourceProformaId String?   @map("source_proforma_id") @db.Uuid
  sourceProforma   Invoice?  @relation("ProformaConversion", fields: [sourceProformaId], references: [id], onDelete: SetNull)
  conversions      Invoice[] @relation("ProformaConversion")

  // --- SAISI à l'édition : volume et prix. Ils peuvent évoluer d'une
  //     proforma à la facture définitive — rien ne les fige.
  billedVolume Decimal       @map("billed_volume") @db.Decimal(18, 6)
  uom          UnitOfMeasure
  /// Prix de vente unitaire, TOUTES TAXES COMPRISES.
  unitPrice Decimal @map("unit_price") @db.Decimal(18, 4)

  // --- Plan TRANSACTION : devise du contrat, fait foi juridiquement ---
  currencyCode String   @map("currency_code") @db.Char(3)
  currency     Currency @relation("InvoiceCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)

  /// Volume × prix unitaire. Dérivé, jamais saisi.
  grossAmount Decimal @map("gross_amount") @db.Decimal(18, 4)

  // --- Réduction commerciale : impacte le montant de vente ---
  discountMode   DiscountMode? @map("discount_mode")
  discountValue  Decimal?      @map("discount_value") @db.Decimal(18, 4)
  /// Montant de la remise, dérivé du mode et de la valeur.
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(18, 4)

  /// TOTAL FACTURE = brut − réduction. C'est le montant dû par le client.
  /// Il ne bouge pas selon que la TVA s'applique ou non : elle y est COMPRISE.
  totalAmount Decimal @map("total_amount") @db.Decimal(18, 4)

  /// TVA EXTRAITE du total, jamais ajoutée :
  ///     TVA = Total × taux ÷ (100 + taux)
  /// Affichée à titre d'information sur la pièce — « dont TVA … ». N'entre
  /// pas dans le calcul de marge ; alimente la TVA collectée, pendant de la
  /// TVA déductible portée par les factures fournisseurs.
  vatAmount Decimal @default(0) @map("vat_amount") @db.Decimal(18, 4)
  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(18, 4)

  // --- Plan PIVOT : risque, marge, en-cours ---
  fxRateToPivot    Decimal   @default(1) @map("fx_rate_to_pivot") @db.Decimal(18, 8)
  fxRateDate       DateTime? @map("fx_rate_date") @db.Date
  totalAmountPivot Decimal   @default(0) @map("total_amount_pivot") @db.Decimal(18, 4)
  paidAmountPivot  Decimal   @default(0) @map("paid_amount_pivot") @db.Decimal(18, 4)

  // --- Plan DOCUMENT : devise d'impression, au choix de l'éditeur ---
  documentCurrencyCode String   @map("document_currency_code") @db.Char(3)
  documentCurrency     Currency @relation("InvoiceDocumentCurrency", fields: [documentCurrencyCode], references: [code], onDelete: Restrict)
  documentFxRate       Decimal  @default(1) @map("document_fx_rate") @db.Decimal(18, 8)
  /// Référence du taux employé : la pièce reste reconstituable à l'identique
  /// des années plus tard, quels que soient les cours ultérieurs.
  documentFxRateId    String?  @map("document_fx_rate_id") @db.Uuid
  documentFxRate_     FxRate?  @relation("InvoiceDocumentFxRate", fields: [documentFxRateId], references: [id], onDelete: Restrict)
  documentVatAmount   Decimal  @default(0) @map("document_vat_amount") @db.Decimal(18, 4)
  documentGrossAmount Decimal  @default(0) @map("document_gross_amount") @db.Decimal(18, 4)
  documentTotalAmount Decimal  @default(0) @map("document_total_amount") @db.Decimal(18, 4)

  // --- Fiscalité (§ 9.4, § 9.5) ---
  /// DÉCLENCHEUR de la TVA : une case propre à la pièce, cochée à l'édition.
  /// Indépendante du client et du produit, qui peuvent la proposer par défaut
  /// sans la déterminer.
  isVatApplicable Boolean @default(false) @map("is_vat_applicable")
  /// Taux paramétré. Il sert à EXTRAIRE la TVA du total, non à l'y ajouter.
  vatRatePct Decimal @default(0) @map("vat_rate_pct") @db.Decimal(6, 3)

  /// MENTION IMPRIMÉE en entête. Purement documentaire : elle n'a aucun effet
  /// sur les montants, qui sont toujours calculés en toutes taxes.
  printedTaxRegime TaxRegime @default(TTC) @map("printed_tax_regime")

  fiscalCountryCode     String  @default("CI") @map("fiscal_country_code") @db.Char(2)
  taxCode               String? @map("tax_code") @db.VarChar(24)
  vatExemptionReference String? @map("vat_exemption_reference") @db.VarChar(120)
  /// Mode de règlement déclaré — requis par la DGI pour toute FNE transmise
  /// (§ 9.5). Saisi à l'édition, comme le volume et le prix.
  paymentMethod InvoicePaymentMethod? @map("payment_method")

  /// Décision INTERNE de recourir à la facture simple (§ 9.3) : un acte humain
  /// qualifié, avec décideur, motif et horodatage — non une règle automatique.
  simpleInvoiceDecidedById String?   @map("simple_invoice_decided_by_id") @db.Uuid
  simpleInvoiceDecidedBy   User?     @relation("SimpleInvoiceDecider", fields: [simpleInvoiceDecidedById], references: [id], onDelete: Restrict)
  simpleInvoiceDecidedAt   DateTime? @map("simple_invoice_decided_at") @db.Timestamptz(3)
  simpleInvoiceReason      String?   @map("simple_invoice_reason") @db.VarChar(1000)

  issueDate DateTime? @map("issue_date") @db.Date
  dueDate   DateTime? @map("due_date") @db.Date

  /// Jeton du QR code d'authenticité apposé sur le PDF (§ 12.2).
  authenticityToken String? @unique @map("authenticity_token") @db.VarChar(64)

  issuedById String?   @map("issued_by_id") @db.Uuid
  issuedBy   User?     @relation("InvoiceIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt   DateTime? @map("issued_at") @db.Timestamptz(3)

  /// Annulation directe (arbitrage du 15/08) — seule voie ouverte pour une
  /// pièce n'ayant JAMAIS reçu d'encaissement. Dès qu'un règlement existe,
  /// même partiel, seul l'avoir corrige : annuler effacerait un encaissement
  /// réel sans laisser de trace de ce qu'il couvrait.
  cancelledById String?   @map("cancelled_by_id") @db.Uuid
  cancelledBy   User?     @relation("InvoiceCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String? @map("cancellation_reason") @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  fneTransmission    FneTransmission?
  payments           Payment[]
  generatedDocuments GeneratedDocument[]
  dunningActions     DunningAction[]

  @@index([dealId, type])
  @@index([partnerId, status])
  @@index([dueDate, status]) // Échéancier / aging list
  @@index([type, status])
  @@map("invoices")
}

enum DunningMethod {
  PHONE
  EMAIL
  LETTER
  VISIT
  OTHER

  @@map("dunning_method")
}

/// Relance client (§ 3.3, § 14.6, § 16 : « facturées non encaissées »).
///
/// ⚠️ MANUEL, PAS AUTOMATIQUE — ET C'EST DÉLIBÉRÉ.
///
///    SPECIFICATIONS.md ne décrit aucun palier d'escalade, aucun canal
///    d'envoi automatisé, aucun délai déclencheur : inventer une politique
///    de relance que personne n'a validée serait improviser une règle de
///    gestion, pas la construire. Ce modèle trace l'ACTION humaine — qui a
///    relancé, comment, quand, pourquoi — sans prétendre l'automatiser.
model DunningAction {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  method DunningMethod
  notes  String        @db.VarChar(1000)

  contactedAt DateTime @map("contacted_at") @db.Timestamptz(3)

  recordedById String @map("recorded_by_id") @db.Uuid
  recordedBy   User   @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([invoiceId, contactedAt(sort: Desc)])
  @@map("dunning_actions")
}

/// Cycle de vie fiscal de la facture normalisée (§ 9.5).
///
/// Les échanges avec la DGI sont ARCHIVÉS : en cas de contrôle, il faut
/// pouvoir montrer ce qui a été envoyé et ce qui a été répondu.
model FneTransmission {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @unique @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  status FneStatus @default(DRAFT)

  /// Référence retournée par le dispositif — portée sur la pièce imprimée.
  fiscalReference String? @unique @map("fiscal_reference") @db.VarChar(64)
  fiscalQrPayload String? @map("fiscal_qr_payload") @db.VarChar(2000)

  transmittedAt DateTime? @map("transmitted_at") @db.Timestamptz(3)
  acceptedAt    DateTime? @map("accepted_at") @db.Timestamptz(3)
  rejectedAt    DateTime? @map("rejected_at") @db.Timestamptz(3)
  rejectionCode   String? @map("rejection_code") @db.VarChar(64)
  rejectionReason String? @map("rejection_reason") @db.VarChar(1000)

  attemptCount Int @default(0) @map("attempt_count") @db.SmallInt

  /// Échanges archivés — requête et réponse, expurgées de tout secret.
  requestPayload  Json? @map("request_payload")
  responsePayload Json? @map("response_payload")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, transmittedAt])
  @@map("fne_transmissions")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  direction PaymentDirection
  partnerId String           @map("partner_id") @db.Uuid
  partner   Partner          @relation("PaymentPartner", fields: [partnerId], references: [id], onDelete: Restrict)

  invoiceId String?  @map("invoice_id") @db.Uuid
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  supplierInvoiceId String?          @map("supplier_invoice_id") @db.Uuid
  supplierInvoice   SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict)

  amount        Decimal  @db.Decimal(18, 4)
  currencyCode  String   @map("currency_code") @db.Char(3)
  currency      Currency @relation("PaymentCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  fxRateToPivot Decimal  @default(1) @map("fx_rate_to_pivot") @db.Decimal(18, 8)
  amountPivot   Decimal  @default(0) @map("amount_pivot") @db.Decimal(18, 4)

  valueDate     DateTime @map("value_date") @db.Date
  bankReference String?  @map("bank_reference") @db.VarChar(120)
  notes         String?  @db.VarChar(1000)

  recordedById String? @map("recorded_by_id") @db.Uuid
  recordedBy   User?   @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([partnerId, valueDate])
  @@index([invoiceId])
  @@index([supplierInvoiceId])
  @@map("payments")
}

/// Facture fournisseur et son prépaiement.
///
/// Réf. § 14.6 — Elyon paie AVANT livraison. Le terme « dettes fournisseurs »
/// du BFR est donc proche de zéro ; ce sont les AVANCES qui pèsent à l'actif :
/// argent sorti, marchandise non encore reçue. C'est ce poste qu'il faut voir
/// en permanence.
model SupplierInvoice {
  id        String @id @default(uuid()) @db.Uuid
  reference String @db.VarChar(64)

  supplierId String  @map("supplier_id") @db.Uuid
  supplier   Partner @relation("SupplierInvoiceSupplier", fields: [supplierId], references: [id], onDelete: Restrict)

  purchaseOrderId String?        @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  /// Rattachement direct au dossier d'affaire : toutes les factures
  /// fournisseurs d'un deal sont consultables au même endroit, y compris
  /// celles sans commande d'achat — fret, inspection, douane.
  dealId String? @map("deal_id") @db.Uuid
  deal   Deal?   @relation("DealSupplierInvoices", fields: [dealId], references: [id], onDelete: SetNull)

  status SupplierInvoiceStatus @default(EXPECTED)

  amount        Decimal  @db.Decimal(18, 4)
  currencyCode  String   @map("currency_code") @db.Char(3)
  currency      Currency @relation("SupplierInvoiceCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  fxRateToPivot Decimal  @default(1) @map("fx_rate_to_pivot") @db.Decimal(18, 8)
  amountPivot   Decimal  @default(0) @map("amount_pivot") @db.Decimal(18, 4)

  paidAmount      Decimal @default(0) @map("paid_amount") @db.Decimal(18, 4)
  paidAmountPivot Decimal @default(0) @map("paid_amount_pivot") @db.Decimal(18, 4)

  /// TVA déductible, extraite du montant de la même façon — pendant de la
  /// TVA collectée sur les ventes.
  vatRatePct Decimal @default(0) @map("vat_rate_pct") @db.Decimal(6, 3)
  vatAmount  Decimal @default(0) @map("vat_amount") @db.Decimal(18, 4)

  /// Montant réglé AVANT réception de la marchandise. Consomme du BFR tant
  /// qu'il n'est pas apuré par la livraison.
  prepaidAmount      Decimal   @default(0) @map("prepaid_amount") @db.Decimal(18, 4)
  prepaidAmountPivot Decimal   @default(0) @map("prepaid_amount_pivot") @db.Decimal(18, 4)
  prepaidAt          DateTime? @map("prepaid_at") @db.Date
  /// Part de l'avance déjà apurée par une contrepartie PHYSIQUEMENT constatée.
  /// Dérivée par trigger au chargement de l'opération, au prorata du volume
  /// enlevé : une avance couvrant trois enlèvements ne s'apure pas au premier.
  settledAmount Decimal @default(0) @map("settled_amount") @db.Decimal(18, 4)
  /// Date d'apurement INTÉGRAL. Tant qu'elle est nulle, le reliquat
  /// (prépayé − apuré) pèse au besoin en fonds de roulement (§ 14.6).
  settledAt DateTime? @map("settled_at") @db.Date

  invoiceDate DateTime  @map("invoice_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date

  recordedById String? @map("recorded_by_id") @db.Uuid
  recordedBy   User?   @relation("SupplierInvoiceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  costLines OperationCostLine[]
  payments  Payment[]

  @@unique([supplierId, reference])
  @@index([dealId])
  @@index([status, dueDate])
  @@index([supplierId, status])
  @@index([prepaidAt, settledAt])
  @@map("supplier_invoices")
}

/// Garanties de paiement — viennent en déduction de l'en-cours (§ 9.1).
model Guarantee {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique @db.VarChar(64)

  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation("GuaranteePartner", fields: [partnerId], references: [id], onDelete: Restrict)
  dealId    String? @map("deal_id") @db.Uuid
  deal      Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  type   GuaranteeType
  status GuaranteeStatus @default(PENDING)

  amount        Decimal  @db.Decimal(18, 4)
  currencyCode  String   @map("currency_code") @db.Char(3)
  currency      Currency @relation("GuaranteeCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  fxRateToPivot Decimal  @default(1) @map("fx_rate_to_pivot") @db.Decimal(18, 8)
  amountPivot   Decimal  @default(0) @map("amount_pivot") @db.Decimal(18, 4)

  issuingBank String?   @map("issuing_bank") @db.VarChar(200)
  issueDate   DateTime  @map("issue_date") @db.Date
  expiryDate  DateTime? @map("expiry_date") @db.Date

  recordedById String? @map("recorded_by_id") @db.Uuid
  recordedBy   User?   @relation("GuaranteeRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([partnerId, status])
  @@index([status, expiryDate])
  @@map("guarantees")
}

// ============================================================================
//  DOCUMENTS ÉMIS ET SIGNATURES
//  Réf. SPECIFICATIONS.md § 12
//
//  Les copies physiques sont transmises au client : l'exemplaire électronique
//  doit correspondre EXACTEMENT à ce qui a été signé. D'où l'empreinte, et le
//  principe « annule et remplace » plutôt que la modification silencieuse.
// ============================================================================

model GeneratedDocument {
  id   String                @id @default(uuid()) @db.Uuid
  kind GeneratedDocumentKind

  /// Numérotation propre au type de document.
  reference String @unique @db.VarChar(48)

  dealId      String?    @map("deal_id") @db.Uuid
  deal        Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  operationId String?    @map("operation_id") @db.Uuid
  operation   Operation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  invoiceId   String?    @map("invoice_id") @db.Uuid
  invoice     Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  storageKey String @unique @map("storage_key") @db.VarChar(512)
  mimeType   String @default("application/pdf") @map("mime_type") @db.VarChar(120)
  sizeBytes  BigInt @map("size_bytes")
  /// Empreinte figée à la signature. Toute divergence entre le papier et le
  /// système se détecte par comparaison.
  sha256 String @db.Char(64)

  /// QR code d'authenticité : un client, un assureur ou un auditeur peut
  /// vérifier qu'un papier qu'on lui présente correspond au système.
  authenticityToken String @unique @map("authenticity_token") @db.VarChar(64)

  /// Une pièce scellée ne se modifie plus. La correction produit un NOUVEAU
  /// document portant « annule et remplace ».
  isSealed Boolean   @default(false) @map("is_sealed")
  sealedAt DateTime? @map("sealed_at") @db.Timestamptz(3)

  supersedesId String?             @unique @map("supersedes_id") @db.Uuid
  supersedes   GeneratedDocument?  @relation("DocumentSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy GeneratedDocument?  @relation("DocumentSupersession")
  supersessionReason String?       @map("supersession_reason") @db.VarChar(1000)

  generatedById String?   @map("generated_by_id") @db.Uuid
  generatedBy   User?     @relation("DocumentGenerator", fields: [generatedById], references: [id], onDelete: SetNull)
  generatedAt   DateTime  @default(now()) @map("generated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  signatures Signature[]

  @@index([kind, generatedAt])
  @@index([dealId])
  @@index([operationId])
  @@map("generated_documents")
}

/// Signature apposée sur un document.
///
/// TOUS les signataires ne sont pas utilisateurs : le chauffeur et le
/// représentant du client signent sans avoir de compte (§ 12.3). L'objet est
/// donc autonome, avec identification à la volée.
model Signature {
  id         String            @id @default(uuid()) @db.Uuid
  documentId String            @map("document_id") @db.Uuid
  document   GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  kind SignatoryKind

  // --- Signataire interne au système, le cas échéant ---
  userId      String?    @map("user_id") @db.Uuid
  user        User?      @relation("SignatureUser", fields: [userId], references: [id], onDelete: SetNull)
  fieldUserId String?    @map("field_user_id") @db.Uuid
  fieldUser   FieldUser? @relation("SignatureFieldUser", fields: [fieldUserId], references: [id], onDelete: SetNull)
  driverId    String?    @map("driver_id") @db.Uuid
  driver      Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)

  // --- Signataire externe identifié à la volée ---
  signatoryName    String  @map("signatory_name") @db.VarChar(160)
  /// Qualité du signataire — indispensable à l'opposabilité.
  signatoryCapacity String @map("signatory_capacity") @db.VarChar(160)
  idDocumentRef    String? @map("id_document_ref") @db.VarChar(64)

  /// Image de la signature manuscrite capturée sur tablette.
  signatureStorageKey String? @map("signature_storage_key") @db.VarChar(512)
  signatureSha256     String? @map("signature_sha256") @db.Char(64)

  /// Les DEUX horodatages sont conservés : l'horloge de l'appareil n'est pas
  /// fiable, et l'écart est en soi un signal d'audit (§ 10.2).
  deviceTimestamp DateTime? @map("device_timestamp") @db.Timestamptz(3)
  serverTimestamp DateTime  @default(now()) @map("server_timestamp") @db.Timestamptz(3)

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([documentId])
  @@index([kind])
  @@map("signatures")
}

// ===========================================================================
//  EXERCICE COMPTABLE ET DONNÉES BUDGÉTAIRES DU CFO (§ 14.2, 14.3, 14.5, 14.6)
//
//  Ces quatre modèles portent ce que le § 19 laissait ouvert : taux de
//  financement réel, budget de charges fixes, prévision de volumes. Rien de
//  tout cela n'est écrit dans le code — ce sont des valeurs d'entreprise, elles
//  se saisissent et se révisent.
//
//  ⚠️ TOUT EST RATTACHÉ À UN EXERCICE, ET L'EXERCICE EST LUI-MÊME UNE DONNÉE.
//
//     Un taux de financement « de 10 % » sans exercice ne veut rien dire : les
//     conditions bancaires se renégocient, et l'affaire close en 2026 doit
//     rester évaluée aux conditions de 2026, pas à celles de 2027. Sans
//     rattachement, changer le taux réécrit le passé.
// ===========================================================================

/// État d'un exercice comptable.
enum FiscalYearStatus {
  PLANNED // Budget en construction, rien n'est opposable.
  OPEN // Exercice courant : les valeurs s'appliquent.
  CLOSED // Clos : les valeurs restent lisibles, plus modifiables.

  @@map("fiscal_year_status")
}

/// Nature d'une prévision : le budget initial ne s'écrase jamais (§ 14.3).
enum ForecastKind {
  BUDGET // Validé par le DG, figé. Une seule version courante par exercice.
  REVISION // Révision trimestrielle, datée, à côté du budget.

  @@map("forecast_kind")
}

/// L'exercice comptable (§ 14.3).
///
/// Ni l'année civile ni une constante : une entreprise peut clôturer en juin,
/// et la Côte d'Ivoire n'impose pas le 31 décembre à toutes les formes
/// sociales. Les bornes sont donc saisies.
model FiscalYear {
  id String @id @default(uuid()) @db.Uuid
  /// Millésime, tel qu'on le nomme : 2026 pour l'exercice 2026.
  year  Int    @unique @db.SmallInt
  label String @db.VarChar(48)

  startsOn DateTime @map("starts_on") @db.Date
  endsOn   DateTime @map("ends_on") @db.Date

  status FiscalYearStatus @default(PLANNED)

  /// Exercice de référence pour les calculs qui n'en désignent pas un.
  /// Un déclencheur garantit qu'il n'y en a jamais deux (§ 11).
  isCurrent Boolean @default(false) @map("is_current")

  notes String? @db.VarChar(500)

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation("FiscalYearAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  financingRates   FinancingRate[]
  salesForecasts   SalesForecast[]
  absorptionRates  AbsorptionRate[]

  @@index([isCurrent])
  @@map("fiscal_years")
}

/// Conditions de financement réelles de l'exercice (§ 5.4, § 14.6).
///
/// Le coût de portage s'en déduit. Il était illustré à 10 % l'an dans un
/// paramètre global — donc identique pour tous les exercices, ce qui revenait à
/// réécrire le coût des affaires passées à chaque renégociation bancaire.
model FinancingRate {
  id           String     @id @default(uuid()) @db.Uuid
  fiscalYearId String     @map("fiscal_year_id") @db.Uuid
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  /// Taux annuel effectif, en pourcentage. 12.5 = 12,5 % l'an.
  annualRatePct Decimal @map("annual_rate_pct") @db.Decimal(9, 4)

  /// Base de jours de l'année financière : 360 en usage bancaire, 365 en
  /// exact/exact. Le choix change le coût de portage de 1,4 %.
  carryingDaysPerYear Int @default(360) @map("carrying_days_per_year") @db.SmallInt

  /// D'où vient le taux — convention de découvert, lettre de crédit, moyenne
  /// pondérée. Sans cette trace, personne ne peut le contester ni le refaire.
  source String? @db.VarChar(240)

  /// Versionnement : une révision crée une ligne, jamais un écrasement.
  version   Int     @default(1) @db.SmallInt
  isCurrent Boolean @default(true) @map("is_current")

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation("FinancingRateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([fiscalYearId, version])
  @@index([fiscalYearId, isCurrent])
  @@map("financing_rates")
}

// ⚠️ `FixedCostBudget` A ÉTÉ SUPPRIMÉ — LES CHARGES FIXES SE DÉRIVENT.
//
//    Elles se saisissaient à part, et décrivaient le MÊME ARGENT que les pools
//    de charges indirectes : le budget administration se tapait une fois dans
//    un pool, une seconde fois ici. Rien ne rapprochait les deux totaux. Le
//    jour où ils divergeaient, le seuil de marge et le point mort racontaient
//    deux histoires différentes, et ni l'un ni l'autre ne le disait.
//
//    Les charges fixes de l'exercice sont désormais la SOMME DES BUDGETS DES
//    POOLS DÉCLARÉS FIXED (voir `CostPool.variability`), exposée par la vue
//    `v_charges_fixes_exercice`. Une seule saisie, deux usages, aucun écart
//    possible.
//
//    Ce qui alimentait le point mort et ce qui alimente le seuil de marge
//    viennent maintenant du même chiffre — ce qui était l'objectif, et ce que
//    deux saisies parallèles ne pouvaient pas garantir.

/// Prévision de vente — maille segment × produit × mois (§ 14.3).
///
/// ⚠️ ON PRÉVOIT UN VOLUME, ON DÉRIVE LE CHIFFRE D'AFFAIRES.
///
///    Le prix bouge sans que l'entreprise le décide — publications DGH, taux de
///    change. Une prévision saisie en chiffre d'affaires laisserait une hausse
///    de prix masquer une perte de volume. Le prix de référence est stocké à
///    part précisément pour que l'écart de PRIX s'analyse séparément de l'écart
///    de VOLUME.
///
/// Le détail client est volontairement écarté : trop lourd à tenir pour ce
/// qu'il apporte. Le détail produit, lui, est indispensable —
/// l'approvisionnement s'engage par produit.
model SalesForecast {
  id           String     @id @default(uuid()) @db.Uuid
  fiscalYearId String     @map("fiscal_year_id") @db.Uuid
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  segment   CommercialSegment
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Mois de l'exercice, 1 à 12 — rang dans l'exercice, pas mois civil : un
  /// exercice qui commence en juillet a son mois 1 en juillet.
  monthIndex Int @map("month_index") @db.SmallInt

  forecastVolume Decimal       @map("forecast_volume") @db.Decimal(18, 4)
  uom            UnitOfMeasure

  /// Quelle publication de prix cette prévision suit.
  ///
  /// ⚠️ SEULE VALEUR À CHOISIR ICI : LE PRIX LUI-MÊME EN DÉCOULE.
  ///
  ///    Le prix se saisissait à la main alors qu'il est déjà publié au
  ///    référentiel des prix administrés. Deux copies d'un même chiffre
  ///    finissent toujours par différer : la DGH publie, personne ne reprend
  ///    la prévision, et le chiffre d'affaires prévisionnel reste calé sur un
  ///    prix que plus personne ne pratique.
  ///
  ///    Ce qu'on ne peut pas deviner en revanche, c'est LAQUELLE des
  ///    publications s'applique : le retail suit le prix à la pompe, le
  ///    soutage un prix contractuel. Prendre « la plus récente » ferait
  ///    basculer la base de calcul au premier arrêté publié sur l'autre
  ///    référence, en silence. On la déclare donc, une fois.
  ///
  /// Nul sur les lignes antérieures à cette règle : elles gardent le prix qui
  /// avait été saisi, et le dire vaut mieux que réécrire leur histoire.
  priceReferenceType PriceReferenceType? @map("price_reference_type")

  /// Prix unitaire de référence servant à dériver le CA prévisionnel.
  ///
  /// CALCULÉS tous deux à l'écriture depuis la publication retenue ci-dessus.
  /// Les défauts n'existent que pour que Prisma ne les exige pas à la
  /// création : le déclencheur les remplace avant que la ligne ne soit posée,
  /// donc avant que la clé étrangère de la devise ne soit vérifiée.
  referencePrice Decimal  @default(0) @map("reference_price") @db.Decimal(18, 4)
  currencyCode   String   @default("") @map("currency_code") @db.Char(3)
  currency       Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  /// BUDGET ou RÉVISION. Le budget validé ne s'écrase jamais (§ 14.3, étape 5).
  kind ForecastKind @default(BUDGET)

  version   Int     @default(1) @db.SmallInt
  isCurrent Boolean @default(true) @map("is_current")

  notes String? @db.VarChar(500)

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation("SalesForecastAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([fiscalYearId, segment, productId, monthIndex, kind, version])
  @@index([fiscalYearId, isCurrent])
  @@map("sales_forecasts")
}

// ===========================================================================
//  CRM — PIPELINE, OPPORTUNITÉS ET INTERACTIONS (§ 15)
//
//  Prospect → Qualification → Opportunité → Offre → Négociation → Contrat →
//  Client → Opération → Facture → Encaissement.
//
//  Le CRM n'est pas un carnet d'adresses : il alimente la PRÉVISION (§ 14.3),
//  qui alimente l'assiette d'absorption (§ 14.2), qui alimente le seuil de
//  marge (§ 5.4). Une opportunité mal tenue se paie trois étages plus loin.
// ===========================================================================

/// Issue d'une étape de pipeline. Détermine ce que l'étape SIGNIFIE, sans
/// figer son libellé ni son rang — les deux se paramètrent.
enum CrmStageOutcome {
  OPEN // L'affaire est vivante et progresse.
  WON // Gagnée : elle devient une affaire.
  LOST // Perdue.
  DORMANT // Mise en veille : ni gagnée ni perdue, sortie du pipeline actif.

  @@map("crm_stage_outcome")
}

/// Nature d'une interaction (§ 15).
enum CrmInteractionKind {
  CALL // Appel
  EMAIL // Courriel
  MEETING // Réunion
  VISIT // Visite
  MESSAGE // Message
  OFFER // Offre
  REPORT // Compte rendu
  DOCUMENT // Document
  COMPLAINT // Réclamation

  @@map("crm_interaction_kind")
}

/// Étape du pipeline commercial (§ 15).
///
/// ⚠️ LES ÉTAPES SONT DES DONNÉES, PAS UNE ÉNUMÉRATION.
///
///    Un pipeline se retaille : on fusionne deux étapes, on en insère une, on
///    change une probabilité après trois mois d'observation. Figé dans le code,
///    chacun de ces gestes devient une migration — donc n'a pas lieu, et le
///    pipeline finit par décrire une organisation qui n'existe plus.
///
/// ⚠️ `probabilityPct` EST DÉLIBÉRÉMENT NULLABLE.
///
///    « Valeur pondérée = CA prévisionnel × Probabilité » (§ 15). Inscrire des
///    probabilités d'illustration — 10 %, 25 %, 50 % — produirait un pipeline
///    pondéré convaincant que personne n'aurait décidé, et sur lequel on
///    engagerait des achats. Tant que la probabilité n'est pas saisie, la
///    valeur pondérée n'est pas calculée et le dit.
model CrmPipelineStage {
  id    String @id @default(uuid()) @db.Uuid
  code  String @unique @db.VarChar(48)
  label String @db.VarChar(120)

  /// Rang dans le pipeline. Unique : deux étapes au même rang rendraient
  /// l'ordre dépendant de l'ordre physique des lignes.
  rank Int @db.SmallInt

  outcome CrmStageOutcome @default(OPEN)

  /// Probabilité de conversion, en pourcentage. NULL = non décidée.
  probabilityPct Decimal? @map("probability_pct") @db.Decimal(5, 2)

  /// Au-delà de ce délai sans interaction, l'opportunité est signalée comme
  /// dormante. NULL = pas de veille sur cette étape.
  stalledAfterDays Int? @map("stalled_after_days") @db.SmallInt

  description String? @db.VarChar(500)
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  opportunities    CrmOpportunity[]
  transitionsFrom  CrmStageTransition[] @relation("CrmTransitionFrom")
  transitionsTo    CrmStageTransition[] @relation("CrmTransitionTo")

  @@unique([rank])
  @@map("crm_pipeline_stages")
}

/// Opportunité commerciale (§ 15).
///
/// ⚠️ LE CA PRÉVISIONNEL N'EST PAS SAISI : IL SE DÉRIVE D'UN VOLUME.
///
///    Même raison qu'au § 14.3 — le prix suit les publications DGH et le
///    change, le volume est ce que l'entreprise pilote. Une opportunité saisie
///    en francs laisserait une hausse de prix masquer une ambition revue à la
///    baisse, et le pipeline alimenterait la prévision avec un chiffre qui ne
///    dit pas ce qu'on croit.
model CrmOpportunity {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique @db.VarChar(24)
  title     String @db.VarChar(200)

  /// Le tiers concerné — PROSPECT ou CLIENT déjà établi. Un prospect est un
  /// tiers comme un autre : le promouvoir en client ne doit pas recréer sa
  /// fiche ni perdre son historique.
  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  segment   CommercialSegment
  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  estimatedVolume Decimal       @map("estimated_volume") @db.Decimal(18, 4)
  uom             UnitOfMeasure

  /// Prix de référence servant à dériver le CA prévisionnel.
  referencePrice Decimal  @map("reference_price") @db.Decimal(18, 4)
  currencyCode   String   @map("currency_code") @db.Char(3)
  currency       Currency @relation("CrmOpportunityCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)

  stageId String           @map("stage_id") @db.Uuid
  stage   CrmPipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  /// Probabilité propre à CETTE opportunité, quand elle diffère de celle de
  /// l'étape. Renseignée, elle prime ; sinon celle de l'étape s'applique.
  probabilityOverridePct Decimal? @map("probability_override_pct") @db.Decimal(5, 2)

  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation("CrmOpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  expectedCloseDate DateTime? @map("expected_close_date") @db.Date

  /// ⚠️ LA PROCHAINE ACTION EST OBLIGATOIRE (§ 15).
  ///
  ///    « Chaque étape porte […] une prochaine action. » Une opportunité sans
  ///    prochaine action n'est pas suivie : elle dort jusqu'à ce que quelqu'un
  ///    la retrouve par hasard. C'est la première cause de pipeline mort.
  nextAction    String   @map("next_action") @db.VarChar(300)
  nextActionDue DateTime @map("next_action_due") @db.Date

  /// Renseignés à la sortie du pipeline. Le motif de perte est ce qu'on relit
  /// en fin de trimestre — sans lui, on refait les mêmes offres.
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(3)
  lossReason String?   @map("loss_reason") @db.VarChar(500)

  /// L'affaire née de l'opportunité gagnée. La boucle du § 15 se ferme ici.
  dealId String? @unique @map("deal_id") @db.Uuid
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  notes String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  interactions CrmInteraction[]
  transitions  CrmStageTransition[]

  @@index([stageId])
  @@index([ownerId])
  @@index([partnerId])
  @@index([nextActionDue])
  @@map("crm_opportunities")
}

/// Passage d'une étape à l'autre — écrit par déclencheur, jamais à la main.
///
/// La probabilité EN VIGUEUR au moment du passage est recopiée : la relire
/// aujourd'hui donnerait la probabilité actuelle de l'étape, et l'analyse de
/// conversion porterait sur des chiffres qui n'ont jamais été ceux du moment.
model CrmStageTransition {
  id            String         @id @default(uuid()) @db.Uuid
  opportunityId String         @map("opportunity_id") @db.Uuid
  opportunity   CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  fromStageId String?           @map("from_stage_id") @db.Uuid
  fromStage   CrmPipelineStage? @relation("CrmTransitionFrom", fields: [fromStageId], references: [id], onDelete: Restrict)
  toStageId   String            @map("to_stage_id") @db.Uuid
  toStage     CrmPipelineStage  @relation("CrmTransitionTo", fields: [toStageId], references: [id], onDelete: Restrict)

  probabilityAtPct Decimal? @map("probability_at_pct") @db.Decimal(5, 2)
  weightedValueAt  Decimal? @map("weighted_value_at") @db.Decimal(18, 4)

  note String? @db.VarChar(500)

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([opportunityId, occurredAt])
  @@map("crm_stage_transitions")
}

/// Interaction avec le tiers (§ 15).
///
/// ⚠️ ACTION SUIVANTE ET DATE DE RELANCE SONT OBLIGATOIRES.
///
///    « Chaque interaction comporte une action suivante et une date de
///    relance. » Facultatives, elles seraient omises précisément sur les
///    échanges anodins — ceux dont on se souvient le moins et qu'on ne relance
///    jamais. La contrainte est portée par la base, pas par l'écran : un import
///    ou un appel d'API la contournerait autrement.
model CrmInteraction {
  id            String         @id @default(uuid()) @db.Uuid
  opportunityId String         @map("opportunity_id") @db.Uuid
  opportunity   CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  kind       CrmInteractionKind
  occurredAt DateTime           @map("occurred_at") @db.Timestamptz(3)

  /// Ce qui s'est dit. Obligatoire : une interaction sans compte rendu ne
  /// transmet rien à celui qui reprendra le dossier.
  summary String @db.VarChar(2000)

  /// Interlocuteur rencontré, tel qu'il s'est présenté.
  contactName String? @map("contact_name") @db.VarChar(160)

  nextAction    String   @map("next_action") @db.VarChar(300)
  nextActionDue DateTime @map("next_action_due") @db.Date

  /// Vrai quand l'action suivante a été faite. C'est ce drapeau, et lui seul,
  /// qui fait disparaître la relance des alertes.
  nextActionDone Boolean @default(false) @map("next_action_done")

  authorId String @map("author_id") @db.Uuid
  author   User   @relation("CrmInteractionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([opportunityId, occurredAt])
  @@index([nextActionDue, nextActionDone])
  @@map("crm_interactions")
}
