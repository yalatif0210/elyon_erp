{
  "name": "@elyon-erp/api",
  "version": "0.1.0",
  "description": "ERP négoce pétrolier — API NestJS",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "//": "Toute évolution du schéma passe par db:migration — jamais par prisma migrate dev seul, sinon le SQL métier de prisma/sql/ n'est pas injecté et Prisma détectera une dérive.",
    "db:migration": "node scripts/prepare-migrations.mjs",
    "db:setup": "npm run prisma:generate && node scripts/prepare-migrations.mjs init && npm run db:migrate && npm run db:seed",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "test": "jest",
    "test:invariants": "jest --testPathPattern=invariants"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.7",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/throttler": "^6.2.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "otplib": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
